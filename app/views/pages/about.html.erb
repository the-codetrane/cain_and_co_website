<% content_for :title, "About · Cain & Co." %>
<% content_for :description, "Cain & Co. — Northern boys with a Southern twang. American blues rock from St. Paul, MN." %>

<%# ── Bio ─────────────────────────────────────────────────────────────── %>
<section class="border-b border-neutral-800">
  <div class="container mx-auto px-5 py-20 max-w-4xl">
    <p class="text-sm uppercase tracking-[0.4em] text-neutral-400 mb-4">Press Kit</p>
    <h1 class="text-4xl sm:text-6xl font-black tracking-tight">Cain &amp; Co.</h1>
    <p class="mt-3 text-xl text-neutral-400 font-medium">Northern Boys with a Southern Twang</p>
    <div class="mt-10 space-y-5 text-lg text-neutral-300 leading-relaxed max-w-2xl">
      <p>
        Hailing from St. Paul, MN, <strong class="text-white">Michael &ldquo;Chris&rdquo; Cain</strong> leads
        a dynamic blues-rock ensemble steeped in Southern tradition. Drawing inspiration from legends like
        <strong class="text-white">The Allman Brothers</strong>, <strong class="text-white">American Aquarium</strong>,
        and <strong class="text-white">Blackberry Smoke</strong>, the band crafts a sound that&rsquo;s both
        soulful and electrifying.
      </p>
      <p>
        With <strong class="text-white">Gabe Voland</strong> on guitar,
        <strong class="text-white">Gunnar Bergman</strong> pounding the drums,
        <strong class="text-white">Gavin Peterson</strong> holding down the bass, and
        <strong class="text-white">Doug Grimm</strong> adding depth on keys, they create a musical journey
        that resonates with authenticity and grit.
      </p>
      <p>
        Cain &amp; Co. brings the traditions of Skynyrd up North &mdash; American blues rock forged in the
        Twin Cities, delivered with the soul of the South.
      </p>
    </div>
    <div class="mt-10 flex flex-wrap gap-4">
      <a href="mailto:booking@cainandco.band"
         class="rounded-full border border-neutral-600 px-6 py-2.5 text-sm font-semibold hover:border-white transition-colors">
        Booking Inquiry
      </a>
      <%= link_to "See upcoming shows", shows_path,
            class: "rounded-full border border-neutral-600 px-6 py-2.5 text-sm font-semibold hover:border-white transition-colors" %>
    </div>
  </div>
</section>

<%# ── Photo Gallery ───────────────────────────────────────────────────── %>
<% if @photos.any? %>
<section class="border-b border-neutral-800">
  <div class="container mx-auto px-5 py-16">
    <h2 class="text-sm uppercase tracking-[0.3em] text-neutral-400 mb-8">Photos</h2>
    <div data-controller="carousel">
      <div class="relative overflow-hidden rounded-2xl bg-neutral-900">
        <div data-carousel-target="track"
             class="flex transition-transform duration-500 ease-in-out will-change-transform">
          <% @photos.each do |photo| %>
            <div data-carousel-target="slide" class="min-w-full">
              <%= image_tag media_src(photo.display(:carousel)), class: "w-full aspect-[4/3] object-cover",
                    loading: "lazy", alt: photo.caption.presence || "Cain & Co." %>
            </div>
          <% end %>
        </div>
        <% if @photos.size > 1 %>
          <button data-action="carousel#prev"
                  class="absolute left-3 top-1/2 -translate-y-1/2 z-10 rounded-full bg-neutral-900/80 border border-neutral-700 p-2.5 hover:bg-neutral-800 transition-colors"
                  aria-label="Previous photo">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>
          <button data-action="carousel#next"
                  class="absolute right-3 top-1/2 -translate-y-1/2 z-10 rounded-full bg-neutral-900/80 border border-neutral-700 p-2.5 hover:bg-neutral-800 transition-colors"
                  aria-label="Next photo">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        <% end %>
      </div>
      <% if @photos.size > 1 %>
        <div class="flex justify-center gap-2 mt-5">
          <% @photos.each_with_index do |_, i| %>
            <button data-carousel-target="dot"
                    data-action="carousel#goTo"
                    data-index="<%= i %>"
                    class="w-2 h-2 rounded-full transition-colors <%= i == 0 ? 'bg-white' : 'bg-neutral-600' %>"
                    aria-label="Photo <%= i + 1 %>"></button>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<%# ── Video Gallery ───────────────────────────────────────────────────── %>
<% if @videos.any? %>
<section class="border-b border-neutral-800">
  <div class="container mx-auto px-5 py-16">
    <h2 class="text-sm uppercase tracking-[0.3em] text-neutral-400 mb-8">Videos</h2>
    <div data-controller="carousel">
      <div class="relative overflow-hidden rounded-2xl bg-neutral-900">
        <div data-carousel-target="track"
             class="flex transition-transform duration-500 ease-in-out will-change-transform">
          <% @videos.each do |video| %>
            <div data-carousel-target="slide" class="min-w-full">
              <%# Shorts are 9:16; regular videos are 16:9 %>
              <div class="<%= video.short? ? 'flex justify-center bg-neutral-900' : '' %>">
                <div class="<%= video.short? ? 'w-full max-w-sm aspect-[9/16]' : 'aspect-video w-full' %>">
                  <iframe src="<%= video.embed_url %>"
                          title="<%= video.title %>"
                          class="w-full h-full"
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                          allowfullscreen
                          loading="lazy"></iframe>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        <% if @videos.size > 1 %>
          <button data-action="carousel#prev"
                  class="absolute left-3 top-1/2 -translate-y-1/2 z-10 rounded-full bg-neutral-900/80 border border-neutral-700 p-2.5 hover:bg-neutral-800 transition-colors"
                  aria-label="Previous video">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>
          <button data-action="carousel#next"
                  class="absolute right-3 top-1/2 -translate-y-1/2 z-10 rounded-full bg-neutral-900/80 border border-neutral-700 p-2.5 hover:bg-neutral-800 transition-colors"
                  aria-label="Next video">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        <% end %>
      </div>
      <% if @videos.size > 1 %>
        <div class="flex justify-center gap-2 mt-5">
          <% @videos.each_with_index do |_, i| %>
            <button data-carousel-target="dot"
                    data-action="carousel#goTo"
                    data-index="<%= i %>"
                    class="w-2 h-2 rounded-full transition-colors <%= i == 0 ? 'bg-white' : 'bg-neutral-600' %>"
                    aria-label="Video <%= i + 1 %>"></button>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<%# ── Press & Reviews ─────────────────────────────────────────────────── %>
<% reviews = @reviews %>
<section class="border-b border-neutral-800">
  <div class="container mx-auto px-5 py-16">
    <h2 class="text-sm uppercase tracking-[0.3em] text-neutral-400 mb-8">Press &amp; Reviews</h2>
    <div data-controller="crossfade">
      <div class="grid">
        <% reviews.each_with_index do |review, i| %>
          <blockquote data-crossfade-target="card"
                      class="col-start-1 row-start-1 transition-opacity duration-700 rounded-2xl border border-neutral-800 bg-neutral-900 p-8 md:p-12 <%= i == 0 ? 'opacity-100' : 'opacity-0 pointer-events-none' %>"
                      aria-hidden="<%= i != 0 %>">
            <p class="text-xl md:text-2xl font-medium text-neutral-100 leading-relaxed">
              &ldquo;<%= review[:quote].html_safe %>&rdquo;
            </p>
            <footer class="mt-6 flex flex-col gap-1">
              <span class="font-semibold text-white">&mdash; <%= review[:author] %></span>
              <span class="text-sm text-neutral-400"><%= review[:source] %></span>
            </footer>
          </blockquote>
        <% end %>
      </div>
      <div class="mt-6 flex items-center justify-center gap-4">
        <button data-action="crossfade#prev"
                class="rounded-full border border-neutral-700 p-2 hover:bg-neutral-800 hover:border-neutral-600 transition-colors"
                aria-label="Previous review">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <div class="flex gap-2">
          <% reviews.each_with_index do |_, i| %>
            <button data-crossfade-target="dot"
                    data-action="crossfade#goTo"
                    data-index="<%= i %>"
                    class="w-2 h-2 rounded-full transition-colors <%= i == 0 ? 'bg-white' : 'bg-neutral-600' %>"
                    aria-label="Review <%= i + 1 %>"></button>
          <% end %>
        </div>
        <button data-action="crossfade#next"
                class="rounded-full border border-neutral-700 p-2 hover:bg-neutral-800 hover:border-neutral-600 transition-colors"
                aria-label="Next review">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>
