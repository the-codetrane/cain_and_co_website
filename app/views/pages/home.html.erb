<% content_for :title, "Cain & Co." %>
<% content_for :description, "The official site for Cain & Co. — upcoming shows, monthly newsletter, and merch. Live music, straight from the band." %>

<%# ── Hero ─────────────────────────────────────────────────────────── %>
<section class="relative overflow-hidden flex justify-center md:h-screen">
  <%= link_to about_path, class: "block w-full md:h-full" do %>
    <%= image_tag "logo_banner.png", alt: "Cain & Co.", class: "w-full h-full object-contain" %>
  <% end %>
</section>

<%# ── Listen / streaming ───────────────────────────────────────────── %>
<section class="border-t border-neutral-800">
  <div class="container mx-auto px-5 py-16">
    <h2 class="text-sm uppercase tracking-[0.3em] text-neutral-400 mb-8">Listen</h2>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <% [
        ["Spotify",     "https://open.spotify.com/playlist/6dP0ime4nMxyeNbN3Y30fg"],
        ["Apple Music", "https://music.apple.com/us/artist/cain-co/1837917282"],
        ["YouTube",     "https://www.youtube.com/@cainandcoband"],
        ["Amazon Music","https://www.amazon.com/music/player/albums/B0FNYHGK29"]
      ].each do |label, url| %>
        <a href="<%= url %>" target="_blank" rel="noopener noreferrer"
           class="rounded-xl border border-neutral-800 bg-neutral-900 px-5 py-6 text-center font-semibold hover:border-neutral-600">
          <%= label %>
        </a>
      <% end %>
    </div>
  </div>
</section>

<%# ── Follow / social ──────────────────────────────────────────────── %>
<section class="border-t border-neutral-800">
  <div class="container mx-auto px-5 py-16">
    <h2 class="text-sm uppercase tracking-[0.3em] text-neutral-400 mb-8">Follow</h2>
    <div class="grid grid-cols-3 gap-4">
      <% [
        ["Facebook",  "https://www.facebook.com/cainandcoband"],
        ["Instagram", "https://www.instagram.com/cainandcoband/"],
        ["TikTok",    "https://www.tiktok.com/@cainandcoband"]
      ].each do |label, url| %>
        <a href="<%= url %>" target="_blank" rel="noopener noreferrer"
           class="rounded-xl border border-neutral-800 bg-neutral-900 px-5 py-6 text-center font-semibold hover:border-neutral-600">
          <%= label %>
        </a>
      <% end %>
    </div>
  </div>
</section>

<%# ── Explore (entry points to upcoming features) ──────────────────── %>
<section class="border-t border-neutral-800">
  <div class="container mx-auto px-5 py-16">
    <div class="grid gap-6 md:grid-cols-3">
      <div id="shows" class="rounded-2xl border border-neutral-800 bg-neutral-900 p-8 scroll-mt-24">
        <h3 class="text-xl font-bold">Tour dates</h3>
        <% if @upcoming_shows.any? %>
          <ul class="mt-4 space-y-3">
            <% @upcoming_shows.each do |show| %>
              <li class="text-sm">
                <span class="text-neutral-400"><%= show.starts_at.strftime("%b %-d") %></span>
                &middot; <%= show.venue_name %><% if show.city.present? %>, <%= show.city %><% end %>
              </li>
            <% end %>
          </ul>
          <%= link_to "All shows →", shows_path, class: "mt-6 inline-block text-sm font-semibold text-white hover:underline" %>
        <% else %>
          <p class="mt-3 text-neutral-400">Catch us live. Tour dates are synced from Bandsintown.</p>
          <%= link_to "See shows →", shows_path, class: "mt-6 inline-block text-sm font-semibold text-white hover:underline" %>
        <% end %>
      </div>
      <div id="newsletter" class="rounded-2xl border border-neutral-800 bg-neutral-900 p-8 scroll-mt-24">
        <h3 class="text-xl font-bold">Monthly newsletter</h3>
        <p class="mt-3 text-neutral-400">News, shows, and releases in your inbox once a month.</p>
        <%= form_with url: newsletter_subscribe_path, method: :post, class: "mt-6 flex flex-col gap-3" do |f| %>
          <%= f.email_field "subscriber[email]", required: true, placeholder: "you@email.com",
                "aria-label": "Email address",
                class: "w-full rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2.5 text-sm placeholder-neutral-500 focus:border-white focus:outline-none" %>
          <%= f.submit "Subscribe",
                class: "rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-neutral-900 hover:bg-neutral-200 cursor-pointer" %>
        <% end %>
        <p class="mt-3 text-xs text-neutral-500">Double opt-in. Unsubscribe anytime.</p>
      </div>
      <div id="merch" class="rounded-2xl border border-neutral-800 bg-neutral-900 p-8 scroll-mt-24">
        <h3 class="text-xl font-bold">Merch store</h3>
        <p class="mt-3 text-neutral-400">Vinyl, shirts, and more. Shipped worldwide.</p>
        <%= link_to "Shop merch →", products_path, class: "mt-6 inline-block text-sm font-semibold text-white hover:underline" %>
      </div>
    </div>

    <%# ── Tip Cup ──────────────────────────────────────────────────────── %>
    <div id="tip-cup" class="mt-6 rounded-2xl border border-neutral-800 bg-neutral-900 p-8 scroll-mt-24"
         data-controller="tip-cup">
      <h3 class="text-xl font-bold">Tip cup</h3>
      <p class="mt-3 text-neutral-400">Enjoyed the show? Toss a tip our way — we appreciate every one.</p>

      <%# Toggle %>
      <div class="mt-6 inline-flex rounded-lg border border-neutral-700 bg-neutral-950 p-1 gap-1">
        <button type="button"
                data-tip-cup-target="venmoTab"
                data-action="click->tip-cup#showVenmo"
                class="rounded-md px-5 py-2 text-sm font-semibold transition-colors">
          Venmo
        </button>
        <button type="button"
                data-tip-cup-target="cashappTab"
                data-action="click->tip-cup#showCashapp"
                class="rounded-md px-5 py-2 text-sm font-semibold transition-colors">
          Cash App
        </button>
      </div>

      <%# Venmo amounts %>
      <div data-tip-cup-target="venmoContent" class="mt-5 flex flex-wrap gap-3">
        <% [5, 10, 20, 50, 100].each do |amount| %>
          <a href="https://account.venmo.com/pay?recipients=cain_co_official&amount=<%= amount %>&note=Tip+for+Cain+%26+Co."
             target="_blank" rel="noopener noreferrer"
             class="rounded-lg border border-neutral-700 bg-neutral-800 px-5 py-2.5 text-sm font-semibold hover:border-neutral-500 hover:bg-neutral-700 transition-colors">
            $<%= amount %>
          </a>
        <% end %>
        <p class="w-full mt-2 text-xs text-neutral-500">@cain_co_official</p>
      </div>

      <%# CashApp amounts %>
      <div data-tip-cup-target="cashappContent" class="hidden mt-5 flex flex-wrap gap-3">
        <% [5, 10, 20, 50, 100].each do |amount| %>
          <a href="https://cash.app/$caincoofficial/<%= amount %>"
             target="_blank" rel="noopener noreferrer"
             class="rounded-lg border border-neutral-700 bg-neutral-800 px-5 py-2.5 text-sm font-semibold hover:border-neutral-500 hover:bg-neutral-700 transition-colors">
            $<%= amount %>
          </a>
        <% end %>
        <p class="w-full mt-2 text-xs text-neutral-500">$caincoofficial</p>
      </div>
    </div>
  </div>
</section>
