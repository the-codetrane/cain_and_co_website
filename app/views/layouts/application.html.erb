<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Cain & Co." %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Cain & Co.">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= content_for?(:description) ? yield(:description).strip : "Cain & Co. — shows, merch, and monthly newsletter." %>">

    <%# OpenGraph %>
    <meta property="og:site_name" content="Cain & Co.">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= content_for?(:title) ? yield(:title).strip : "Cain & Co." %>">
    <meta property="og:description" content="<%= content_for?(:description) ? yield(:description).strip : "Cain & Co. — shows, merch, and monthly newsletter." %>">
    <meta property="og:url" content="<%= request.base_url + request.path %>">
    <meta property="og:image" content="<%= content_for?(:og_image) ? yield(:og_image).strip : "#{request.base_url}/icon.png" %>">

    <%# Twitter card %>
    <meta name="twitter:card" content="summary">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% if (vapid_key = Rails.application.credentials.dig(:vapid, :public_key)) %>
      <meta name="vapid-public-key" content="<%= vapid_key %>">
    <% end %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Tailwind build first, then app-wide custom overrides %>
    <%= stylesheet_link_tag "tailwind", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-neutral-950 text-neutral-100 antialiased flex flex-col">
    <%= render "shared/public_nav" %>

    <% if notice || alert %>
      <div class="px-5">
        <div class="container mx-auto mt-4">
          <% if notice %>
            <p class="rounded-lg bg-emerald-900/60 border border-emerald-700 px-4 py-3 text-sm text-emerald-100"><%= notice %></p>
          <% end %>
          <% if alert %>
            <p class="rounded-lg bg-red-900/60 border border-red-700 px-4 py-3 text-sm text-red-100"><%= alert %></p>
          <% end %>
        </div>
      </div>
    <% end %>

    <main class="flex-1">
      <%= yield %>
    </main>

    <%= render "shared/public_footer" %>
    <%= render "shared/push_prompt" %>
  </body>
</html>
