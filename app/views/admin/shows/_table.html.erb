<% if shows.any? %>
  <div class="mt-3 overflow-hidden rounded-xl border border-neutral-200 bg-white divide-y divide-neutral-200">
    <% shows.each do |show| %>
      <%= render "admin/shows/row", show: show %>
    <% end %>
  </div>
<% else %>
  <p class="mt-3 text-sm text-neutral-500"><%= empty %></p>
<% end %>
