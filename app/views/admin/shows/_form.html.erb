<%= form_with model: [:admin, show] do |f| %>
  <% if show.errors.any? %>
    <div class="mb-5 rounded-md bg-red-100 border border-red-300 px-4 py-3 text-sm text-red-900">
      <p class="font-semibold"><%= pluralize(show.errors.count, "error") %> prevented saving:</p>
      <ul class="mt-1 list-disc list-inside">
        <% show.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <% field = "block w-full rounded-md border border-neutral-300 px-3 py-2 text-sm focus:border-neutral-900 focus:outline-none" %>
  <% label = "block text-sm font-medium text-neutral-700 mb-1" %>

  <div class="space-y-5">
    <div>
      <%= f.label :title, class: label %>
      <%= f.text_field :title, class: field, required: true %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <%= f.label :starts_at, "Starts at", class: label %>
        <%= f.datetime_local_field :starts_at, class: field, required: true %>
      </div>
      <div>
        <%= f.label :ends_at, "Ends at (optional)", class: label %>
        <%= f.datetime_local_field :ends_at, class: field %>
      </div>
    </div>

    <div>
      <%= f.label :venue_name, "Venue", class: label %>
      <%= f.text_field :venue_name, class: field %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      <div><%= f.label :city, class: label %><%= f.text_field :city, class: field %></div>
      <div><%= f.label :region, "Region/State", class: label %><%= f.text_field :region, class: field %></div>
      <div><%= f.label :country, class: label %><%= f.text_field :country, class: field %></div>
    </div>

    <div>
      <%= f.label :bandsintown_url, "Ticket/info URL (optional)", class: label %>
      <%= f.url_field :bandsintown_url, class: field, placeholder: "https://…" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <%= f.label :attendance, "Attendance (headcount, after the show)", class: label %>
        <%= f.number_field :attendance, min: 0, inputmode: "numeric", class: "w-32 rounded-md border border-neutral-300 px-3 py-2 text-sm focus:border-neutral-900 focus:outline-none" %>
      </div>
      <div>
        <%= f.label :ticket_sales, "Ticket sales ($, after the show)", class: label %>
        <%= f.number_field :ticket_sales, min: 0, step: 1, inputmode: "numeric", class: "w-32 rounded-md border border-neutral-300 px-3 py-2 text-sm focus:border-neutral-900 focus:outline-none" %>
      </div>
    </div>

    <div class="flex min-h-11 items-center gap-2 md:min-h-0">
      <%= f.check_box :free, class: "h-4 w-4 rounded border-neutral-300" %>
      <%= f.label :free, "Free show (no cover — hides the Tickets button)", class: "text-sm text-neutral-700" %>
    </div>

    <div>
      <%= f.label :description, "Description (optional)", class: label %>
      <%= f.text_area :description, rows: 3, class: field %>
    </div>
  </div>

  <div class="mt-6 flex items-center gap-3">
    <%= f.submit class: "rounded-md bg-neutral-900 px-4 py-2 text-sm font-semibold text-white hover:bg-neutral-700" %>
    <%= link_to "Cancel", admin_shows_path, class: "admin-tap text-sm text-neutral-500 hover:text-neutral-900" %>
  </div>
<% end %>
