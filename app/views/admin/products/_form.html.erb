<%= form_with model: [:admin, product] do |f| %>
  <% if product.errors.any? %>
    <div class="mb-5 rounded-md bg-red-100 border border-red-300 px-4 py-3 text-sm text-red-900">
      <p class="font-semibold"><%= pluralize(product.errors.count, "error") %> prevented saving:</p>
      <ul class="mt-1 list-disc list-inside">
        <% product.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <% field = "block w-full rounded-md border border-neutral-300 px-3 py-2 text-sm focus:border-neutral-900 focus:outline-none" %>
  <% label = "block text-sm font-medium text-neutral-700 mb-1" %>

  <div class="space-y-5">
    <div>
      <%= f.label :name, class: label %>
      <%= f.text_field :name, class: field, required: true %>
    </div>

    <div>
      <%= f.label :description, class: label %>
      <%= f.text_area :description, rows: 4, class: field, placeholder: "Describe the product — materials, sizing notes, etc." %>
    </div>

    <div>
      <%= f.label :images, "Images (optional)", class: label %>
      <%= f.file_field :images, multiple: true, accept: "image/*",
            class: "block w-full text-sm text-neutral-500 file:mr-4 file:rounded-md file:border-0 file:bg-neutral-100 file:px-3 file:py-1.5 file:text-sm file:font-semibold hover:file:bg-neutral-200" %>
      <% if product.images.attached? %>
        <p class="mt-1 text-xs text-neutral-500"><%= product.images.count %> image(s) attached.</p>
      <% end %>
    </div>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <label class="flex items-center gap-2 text-sm font-medium text-neutral-700">
        <%= f.check_box :published, class: "h-4 w-4 rounded border-neutral-300" %>
        Published (visible to fans)
      </label>
      <label class="flex items-center gap-2 text-sm font-medium text-neutral-700">
        <%= f.check_box :featured, class: "h-4 w-4 rounded border-neutral-300" %>
        Featured on homepage
      </label>
    </div>
  </div>

  <div class="mt-6 flex items-center gap-3">
    <%= f.submit class: "rounded-md bg-neutral-900 px-4 py-2 text-sm font-semibold text-white hover:bg-neutral-700" %>
    <%= link_to "Cancel", admin_products_path, class: "admin-tap text-sm text-neutral-500 hover:text-neutral-900" %>
  </div>
<% end %>
