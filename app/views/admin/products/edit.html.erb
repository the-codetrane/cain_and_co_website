<% content_for :title, "Edit #{@product.name} · Admin" %>

<div class="mb-6">
  <%= link_to "← #{@product.name}", admin_product_path(@product), class: "text-sm text-neutral-500 hover:text-neutral-900" %>
  <h1 class="mt-2 text-2xl font-bold tracking-tight">Edit product</h1>
</div>

<div class="rounded-xl border border-neutral-200 bg-white p-6">
  <%= render "form", product: @product %>
</div>
