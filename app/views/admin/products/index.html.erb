<% content_for :title, "Products · Admin" %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold tracking-tight">Products</h1>
  <%= link_to "New product", new_admin_product_path,
        class: "rounded-md bg-neutral-900 px-3 py-1.5 text-sm font-semibold text-white hover:bg-neutral-700" %>
</div>

<% if @products.any? %>

  <%# Mobile: card list %>
  <div class="mt-6 space-y-3 md:hidden">
    <% @products.each do |product| %>
      <div class="rounded-xl border border-neutral-200 bg-white p-4">
        <div class="relative flex items-start justify-between gap-3">
          <div class="flex min-w-0 items-start gap-3">
            <%= render "thumbnail", product: product %>
            <div class="min-w-0">
              <%= link_to product.name, admin_product_path(product),
                    class: "font-semibold hover:underline block truncate after:absolute after:inset-0" %>
              <p class="mt-0.5 text-sm text-neutral-400">
                <%= product.variants.size %> variant<%= product.variants.size == 1 ? "" : "s" %>
                <% if product.lowest_price_cents %>
                  &middot; from $<%= "%.2f" % (product.lowest_price_cents / 100.0) %>
                <% end %>
              </p>
            </div>
          </div>
          <% if product.published? %>
            <span class="shrink-0 rounded-full bg-emerald-100 px-2 py-0.5 text-xs text-emerald-700">Published</span>
          <% else %>
            <span class="shrink-0 rounded-full bg-neutral-100 px-2 py-0.5 text-xs text-neutral-500">Draft</span>
          <% end %>
        </div>
        <div class="mt-3 flex items-center justify-between border-t border-neutral-100 pt-1">
          <%= link_to "Edit", edit_admin_product_path(product),
                class: "admin-tap text-sm text-neutral-500 hover:text-neutral-900" %>
          <%= button_to "Delete", admin_product_path(product), method: :delete,
                form: { data: { turbo_confirm: "Delete #{product.name}? This also removes all its variants." } },
                class: "text-sm text-red-500 hover:text-red-700" %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Desktop: table %>
  <div class="mt-8 hidden md:block overflow-hidden rounded-xl border border-neutral-200 bg-white">
    <table class="w-full text-sm">
      <thead class="border-b border-neutral-200 bg-neutral-50 text-left text-xs font-semibold uppercase tracking-wider text-neutral-500">
        <tr>
          <th class="px-4 py-3">Product</th>
          <th class="px-4 py-3">Variants</th>
          <th class="px-4 py-3">Price from</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-100">
        <% @products.each do |product| %>
          <tr>
            <td class="px-4 py-3 font-medium">
              <div class="flex items-center gap-3">
                <%= render "thumbnail", product: product %>
                <%= link_to product.name, admin_product_path(product), class: "hover:underline" %>
              </div>
            </td>
            <td class="px-4 py-3 text-neutral-500"><%= product.variants.size %></td>
            <td class="px-4 py-3 text-neutral-500">
              <% if product.lowest_price_cents %>
                $<%= "%.2f" % (product.lowest_price_cents / 100.0) %>
              <% else %>
                <span class="text-neutral-300">—</span>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <% if product.published? %>
                <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs text-emerald-700">Published</span>
              <% else %>
                <span class="rounded-full bg-neutral-100 px-2 py-0.5 text-xs text-neutral-500">Draft</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right">
              <%= link_to "Edit", edit_admin_product_path(product), class: "text-neutral-500 hover:text-neutral-900 mr-3" %>
              <%= button_to "Delete", admin_product_path(product), method: :delete,
                    form: { data: { turbo_confirm: "Delete #{product.name}? This also removes all its variants." } },
                    class: "text-red-500 hover:text-red-700 text-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

<% else %>
  <div class="mt-8 rounded-xl border border-neutral-200 bg-white p-10 text-center">
    <p class="text-neutral-500">No products yet.</p>
    <%= link_to "Add your first product →", new_admin_product_path, class: "mt-3 inline-block text-sm font-semibold hover:underline" %>
  </div>
<% end %>
