<% content_for :title, "#{@product.name} · Admin" %>

<div class="flex flex-wrap items-start justify-between gap-3">
  <div>
    <%= link_to "← Products", admin_products_path, class: "text-sm text-neutral-500 hover:text-neutral-900" %>
    <h1 class="mt-2 text-2xl font-bold tracking-tight"><%= @product.name %></h1>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to "Edit product", edit_admin_product_path(@product),
          class: "rounded-md border border-neutral-300 bg-white px-3 py-1.5 text-sm font-semibold hover:bg-neutral-50" %>
    <%= button_to "Delete", admin_product_path(@product), method: :delete,
          form: { data: { turbo_confirm: "Delete #{@product.name}?" } },
          class: "rounded-md bg-red-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-red-700" %>
  </div>
</div>

<%# Product details %>
<div class="mt-6 rounded-xl border border-neutral-200 bg-white p-6">
  <div class="flex flex-wrap items-center gap-3">
    <% if @product.published? %>
      <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs text-emerald-700">Published</span>
    <% else %>
      <span class="rounded-full bg-neutral-100 px-2.5 py-1 text-xs text-neutral-500">Draft</span>
    <% end %>
    <% if @product.featured? %>
      <span class="rounded-full bg-blue-100 px-2.5 py-1 text-xs text-blue-700">Featured</span>
    <% end %>
  </div>

  <% if @product.description.present? %>
    <p class="mt-4 text-sm text-neutral-600"><%= @product.description %></p>
  <% end %>

  <% if @product.images.attached? %>
    <div class="mt-4 flex flex-wrap gap-3">
      <% @product.images.each do |image| %>
        <%= image_tag image.variant(resize_to_limit: [200, 200]),
              class: "h-24 w-24 rounded-lg object-cover border border-neutral-200",
              alt: @product.name %>
      <% end %>
    </div>
  <% end %>
</div>

<%# Variants %>
<div class="mt-8 flex flex-wrap items-center justify-between gap-3">
  <h2 class="text-lg font-semibold">Variants</h2>
  <%= link_to "Add variant", new_admin_product_variant_path(@product),
        class: "rounded-md border border-neutral-300 bg-white px-3 py-1.5 text-sm font-semibold hover:bg-neutral-50" %>
</div>

<%= render "admin/variants/size_picker", product: @product %>

<% if @product.variants.any? %>
  <div class="mt-4 overflow-hidden rounded-xl border border-neutral-200 bg-white">
    <table class="w-full text-sm">
      <thead class="border-b border-neutral-200 bg-neutral-50 text-left text-xs font-semibold uppercase tracking-wider text-neutral-500">
        <tr>
          <th class="px-4 py-3">Name</th>
          <th class="px-4 py-3">Order</th>
          <th class="px-4 py-3">SKU</th>
          <th class="px-4 py-3">Price</th>
          <th class="px-4 py-3">Stock</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-100">
        <% @product.variants.each do |variant| %>
          <tr>
            <td class="px-4 py-3 font-medium"><%= variant.name %></td>
            <td class="px-4 py-3 text-neutral-400 tabular-nums"><%= variant.position %></td>
            <td class="px-4 py-3 text-neutral-500 font-mono text-xs"><%= variant.sku.presence || "—" %></td>
            <td class="px-4 py-3">$<%= "%.2f" % variant.price_dollars %></td>
            <td class="px-4 py-3">
              <% if variant.in_stock? %>
                <span class="text-emerald-700"><%= variant.stock_quantity %></span>
              <% else %>
                <span class="text-red-600">Out of stock</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right">
              <%= link_to "Edit", edit_admin_product_variant_path(@product, variant), class: "text-neutral-500 hover:text-neutral-900 mr-3" %>
              <%= button_to "Delete", admin_product_variant_path(@product, variant), method: :delete,
                    form: { data: { turbo_confirm: "Delete #{variant.name}?" } },
                    class: "text-red-500 hover:text-red-700 text-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="mt-3 rounded-xl border border-neutral-200 bg-white p-8 text-center">
    <p class="text-neutral-500">No variants yet. Add sizes above, or add a one-off option, before publishing.</p>
    <%= link_to "Add variant →", new_admin_product_variant_path(@product), class: "mt-3 inline-block text-sm font-semibold hover:underline" %>
  </div>
<% end %>
