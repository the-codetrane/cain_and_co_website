<% content_for :title, "#{@product.name} · Admin" %>

<div class="flex flex-wrap items-start justify-between gap-3">
  <div>
    <%= link_to "← Products", admin_products_path, class: "admin-tap text-sm text-neutral-500 hover:text-neutral-900" %>
    <h1 class="mt-2 text-2xl font-bold tracking-tight"><%= @product.name %></h1>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to "Edit product", edit_admin_product_path(@product),
          class: "rounded-md border border-neutral-300 bg-white px-3 py-1.5 text-sm font-semibold hover:bg-neutral-50" %>
    <%= button_to "Delete", admin_product_path(@product), method: :delete,
          form: { data: { turbo_confirm: "Delete #{@product.name}?" } },
          class: "rounded-md bg-red-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-red-700" %>
  </div>
</div>

<%# Product details %>
<div class="mt-6 rounded-xl border border-neutral-200 bg-white p-4 md:p-6">
  <div class="flex flex-wrap items-center gap-3">
    <% if @product.published? %>
      <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs text-emerald-700">Published</span>
    <% else %>
      <span class="rounded-full bg-neutral-100 px-2.5 py-1 text-xs text-neutral-500">Draft</span>
    <% end %>
    <% if @product.featured? %>
      <span class="rounded-full bg-blue-100 px-2.5 py-1 text-xs text-blue-700">Featured</span>
    <% end %>
  </div>

  <% if @product.description.present? %>
    <p class="mt-4 text-sm text-neutral-600"><%= @product.description %></p>
  <% end %>

  <% if @product.images.attached? %>
    <div class="mt-4 flex flex-wrap gap-3">
      <% @product.images.each do |image| %>
        <%= image_tag image.variant(resize_to_limit: [200, 200]),
              class: "h-24 w-24 rounded-lg object-cover border border-neutral-200",
              alt: @product.name %>
      <% end %>
    </div>
  <% end %>
</div>

<%# Variants %>
<div class="mt-8 flex flex-wrap items-center justify-between gap-3">
  <h2 class="text-lg font-semibold">Variants</h2>
  <%= link_to "Add variant", new_admin_product_variant_path(@product),
        class: "rounded-md border border-neutral-300 bg-white px-3 py-1.5 text-sm font-semibold hover:bg-neutral-50" %>
</div>

<%# Rows reflow into cards below md rather than rendering twice: the stock cell is
    swapped by dom id, so it has to exist exactly once on the page. %>
<% if @product.variants.any? %>
  <div class="mt-4 overflow-hidden rounded-xl border border-neutral-200 bg-white">
    <table class="block w-full text-sm md:table">
      <thead class="hidden border-b border-neutral-200 bg-neutral-50 text-left text-xs font-semibold uppercase tracking-wider text-neutral-500 md:table-header-group">
        <tr>
          <th class="px-4 py-3">Name</th>
          <th class="px-4 py-3">Order</th>
          <th class="px-4 py-3">SKU</th>
          <th class="px-4 py-3">Price</th>
          <th class="px-4 py-3">Weight</th>
          <th class="px-4 py-3">Stock</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="block divide-y divide-neutral-100 md:table-row-group">
        <% @product.variants.each do |variant| %>
          <tr class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-3 gap-y-1 p-4 md:table-row md:p-0">
            <td class="col-start-1 row-start-1 font-medium break-words md:px-4 md:py-3"><%= variant.name %></td>
            <td class="hidden px-4 py-3 text-neutral-400 tabular-nums md:table-cell"><%= variant.position %></td>
            <td class="col-start-1 row-start-2 break-all text-neutral-500 font-mono text-xs md:px-4 md:py-3"><%= variant.sku.presence || "—" %></td>
            <td class="col-start-2 row-start-1 text-right md:px-4 md:py-3 md:text-left">$<%= "%.2f" % variant.price_dollars %></td>
            <td class="col-start-2 row-start-2 text-right tabular-nums text-neutral-500 md:px-4 md:py-3 md:text-left md:text-neutral-900">
              <% if variant.weighed? %>
                <%= variant.weight_oz %> oz
              <% else %>
                <span class="text-neutral-400">
                  <%= Variant::DEFAULT_WEIGHT_OZ %> oz<span aria-hidden="true">*</span>
                  <span class="sr-only">— not weighed; shipping assumes <%= Variant::DEFAULT_WEIGHT_OZ %> oz</span>
                </span>
              <% end %>
            </td>
            <td class="col-span-2 row-start-3 mt-2 flex items-center justify-between gap-3 md:mt-0 md:table-cell md:px-4 md:py-3">
              <span class="text-neutral-500 md:hidden">Stock</span>
              <%= render "admin/variants/stock", product: @product, variant: variant %>
            </td>
            <td class="col-span-2 row-start-4 mt-2 flex items-center justify-between border-t border-neutral-100 pt-1 md:mt-0 md:table-cell md:border-0 md:px-4 md:py-3 md:text-right">
              <%= link_to "Edit", edit_admin_product_variant_path(@product, variant), class: "admin-tap text-neutral-500 hover:text-neutral-900 md:mr-3" %>
              <%= button_to "Delete", admin_product_variant_path(@product, variant), method: :delete,
                    form: { data: { turbo_confirm: "Delete #{variant.name}?" } },
                    class: "text-red-500 hover:text-red-700 text-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @product.variants.any? { |variant| !variant.weighed? } %>
    <p class="mt-2 text-xs text-neutral-500">
      <span aria-hidden="true">*</span>
      Not weighed yet — shipping for these variants is estimated at <%= Variant::DEFAULT_WEIGHT_OZ %> oz.
    </p>
  <% end %>

  <%= render "admin/variants/size_picker", product: @product %>
<% else %>
  <%= render "admin/variants/size_picker", product: @product %>

  <div class="mt-3 rounded-xl border border-neutral-200 bg-white p-8 text-center">
    <p class="text-neutral-500">No variants yet. Add sizes above, or add a one-off option, before publishing.</p>
    <%= link_to "Add variant →", new_admin_product_variant_path(@product), class: "mt-3 inline-block text-sm font-semibold hover:underline" %>
  </div>
<% end %>
