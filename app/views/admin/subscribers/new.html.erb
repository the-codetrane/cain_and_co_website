<% content_for :title, "Add subscriber · Admin" %>

<div class="max-w-md">
  <h1 class="text-2xl font-bold tracking-tight">Add a subscriber</h1>
  <p class="mt-1 text-sm text-neutral-500">Added subscribers are marked confirmed immediately (no opt-in email).</p>

  <%= form_with model: [:admin, @subscriber], class: "mt-8" do |f| %>
    <% if @subscriber.errors.any? %>
      <div class="mb-5 rounded-md bg-red-100 border border-red-300 px-4 py-3 text-sm text-red-900">
        <ul class="list-disc list-inside">
          <% @subscriber.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <%= f.label :email, class: "block text-sm font-medium text-neutral-700 mb-1" %>
    <%= f.email_field :email, required: true,
          class: "block w-full rounded-md border border-neutral-300 px-3 py-2 text-sm focus:border-neutral-900 focus:outline-none" %>

    <div class="mt-6 flex items-center gap-3">
      <%= f.submit "Add subscriber", class: "rounded-md bg-neutral-900 px-4 py-2 text-sm font-semibold text-white hover:bg-neutral-700 cursor-pointer" %>
      <%= link_to "Cancel", admin_subscribers_path, class: "text-sm text-neutral-500 hover:text-neutral-900" %>
    </div>
  <% end %>
</div>
