<% content_for :title, "Import subscribers · Admin" %>

<div class="max-w-md">
  <h1 class="text-2xl font-bold tracking-tight">Import subscribers</h1>
  <p class="mt-1 text-sm text-neutral-500">
    Upload a CSV file with an <strong>Email</strong> column. Imported subscribers are confirmed immediately.
    Existing emails are skipped.
  </p>

  <% if flash[:alert] %>
    <div class="mt-5 rounded-md bg-red-100 border border-red-300 px-4 py-3 text-sm text-red-900 space-y-2">
      <p class="font-semibold"><%= flash[:alert] %></p>
      <p>Your CSV must include a header row with at least an <strong>Email</strong> column. Other columns are ignored. Example:</p>
      <pre class="mt-1 rounded bg-red-50 px-3 py-2 text-xs font-mono text-red-800 overflow-x-auto">Email,First Name,Last Name
alice@example.com,Alice,Smith
bob@example.com,,</pre>
    </div>
  <% end %>

  <%= form_with url: import_admin_subscribers_path, method: :post, multipart: true, class: "mt-8" do |f| %>
    <div>
      <%= f.label :csv_file, "CSV file", class: "block text-sm font-medium text-neutral-700 mb-1" %>
      <%= f.file_field :csv_file, accept: ".csv,text/csv", required: true,
            class: "block w-full text-sm text-neutral-700 file:mr-4 file:rounded-md file:border-0 file:bg-neutral-900 file:px-3 file:py-1.5 file:text-sm file:font-semibold file:text-white hover:file:bg-neutral-700 cursor-pointer" %>
      <p class="mt-1.5 text-xs text-neutral-500">The file must include an "Email" column header (case-insensitive).</p>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <%= f.submit "Import", class: "rounded-md bg-neutral-900 px-4 py-2 text-sm font-semibold text-white hover:bg-neutral-700 cursor-pointer" %>
      <%= link_to "Cancel", admin_subscribers_path, class: "admin-tap text-sm text-neutral-500 hover:text-neutral-900" %>
    </div>
  <% end %>
</div>
