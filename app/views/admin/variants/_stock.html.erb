<%# A variant's stock count with its +/- buttons, in the product page's variants
    table. Re-rendered on its own (Turbo Stream replace by dom id) after each click. %>
<% button_class = "size-7 rounded-md border border-neutral-300 bg-white font-semibold leading-none hover:bg-neutral-50 disabled:cursor-not-allowed disabled:opacity-40" %>
<div id="<%= dom_id(variant, :stock) %>" class="flex items-center gap-2">
  <%= button_to "−", decrement_stock_admin_product_variant_path(product, variant), method: :patch,
        disabled: !variant.in_stock?, "aria-label": "Decrease stock of #{variant.name}", class: button_class %>
  <% if variant.in_stock? %>
    <span class="min-w-6 text-center tabular-nums text-emerald-700"><%= variant.stock_quantity %></span>
  <% else %>
    <span class="text-red-600">Out of stock</span>
  <% end %>
  <%= button_to "+", increment_stock_admin_product_variant_path(product, variant), method: :patch,
        "aria-label": "Increase stock of #{variant.name}", class: button_class %>
</div>
