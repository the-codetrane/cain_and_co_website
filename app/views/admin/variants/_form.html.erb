<%= form_with model: [:admin, product, variant] do |f| %>
  <% if variant.errors.any? %>
    <div class="mb-5 rounded-md bg-red-100 border border-red-300 px-4 py-3 text-sm text-red-900">
      <p class="font-semibold"><%= pluralize(variant.errors.count, "error") %> prevented saving:</p>
      <ul class="mt-1 list-disc list-inside">
        <% variant.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <% field = "block w-full rounded-md border border-neutral-300 px-3 py-2 text-sm focus:border-neutral-900 focus:outline-none" %>
  <% label = "block text-sm font-medium text-neutral-700 mb-1" %>

  <div class="space-y-5">
    <div>
      <%= f.label :name, "Variant name (e.g. M, Black, One Size)", class: label %>
      <%= f.text_field :name, class: field, required: true, placeholder: "M" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <%= f.label :price_cents, "Price (in cents)", class: label %>
        <div class="relative">
          <span class="absolute inset-y-0 left-3 flex items-center text-neutral-400 text-sm">¢</span>
          <%= f.number_field :price_cents, class: "#{field} pl-7", min: 0, required: true,
                placeholder: "2500 = $25.00" %>
        </div>
        <p class="mt-1 text-xs text-neutral-400">Enter price in cents, e.g. 2500 for $25.00</p>
      </div>
      <div>
        <%= f.label :stock_quantity, "Stock quantity", class: label %>
        <%= f.number_field :stock_quantity, class: field, min: 0, required: true %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <%= f.label :sku, "SKU (optional)", class: label %>
        <%= f.text_field :sku, class: field, placeholder: "MERCH-001-S" %>
      </div>
      <div>
        <%= f.label :position, "Sort order (optional)", class: label %>
        <%= f.number_field :position, class: field, min: 0 %>
        <p class="mt-1 text-xs text-neutral-400">
          Leave at 0 to place automatically — recognised sizes
          (<%= Variant::SIZES.join(", ") %>) sort in that order, anything else goes last.
        </p>
      </div>
    </div>
  </div>

  <div class="mt-6 flex items-center gap-3">
    <%= f.submit class: "rounded-md bg-neutral-900 px-4 py-2 text-sm font-semibold text-white hover:bg-neutral-700" %>
    <%= link_to "Cancel", admin_product_path(product), class: "text-sm text-neutral-500 hover:text-neutral-900" %>
  </div>
<% end %>
