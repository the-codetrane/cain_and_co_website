<%# Bulk "size buttons" picker — creates one variant per selected size in a single
    submit. Sizes already on the product are shown as taken and cannot be re-added. %>
<% existing = product.existing_size_names %>
<% available = Variant::SIZES - existing %>

<div class="mt-3 rounded-xl border border-neutral-200 bg-white p-4 md:p-6">
  <h3 class="text-sm font-semibold">Add sizes</h3>
  <p class="mt-1 text-xs text-neutral-500">
    Pick the sizes this product comes in — each one becomes a variant at the price and stock below.
  </p>

  <% if available.any? %>
    <%= form_with url: add_sizes_admin_product_variants_path(product), method: :post do |f| %>
      <div class="mt-4 flex flex-wrap gap-2">
        <% Variant::SIZES.each do |size| %>
          <% taken = existing.include?(size) %>
          <% if taken %>
            <span class="flex min-h-11 cursor-not-allowed items-center rounded-lg border border-neutral-200 bg-neutral-100 px-4 py-2 text-sm font-semibold text-neutral-400 line-through"
                  title="Already added">
              <%= size %>
            </span>
          <% else %>
            <label class="flex min-h-11 cursor-pointer select-none items-center rounded-lg border border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700 transition-colors hover:border-neutral-500 has-[:checked]:border-neutral-900 has-[:checked]:bg-neutral-900 has-[:checked]:text-white">
              <%= check_box_tag "sizes[]", size, false, class: "sr-only" %>
              <%= size %>
            </label>
          <% end %>
        <% end %>
      </div>

      <div class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-3">
        <div>
          <%= label_tag :price_cents, "Price (in cents)", class: "block text-sm font-medium text-neutral-700 mb-1" %>
          <%= number_field_tag :price_cents, product.lowest_price_cents,
                min: 0, inputmode: "numeric", required: true, placeholder: "2500 = $25.00",
                class: "block w-full rounded-md border border-neutral-300 px-3 py-2 text-sm focus:border-neutral-900 focus:outline-none" %>
        </div>
        <div>
          <%= label_tag :stock_quantity, "Stock per size", class: "block text-sm font-medium text-neutral-700 mb-1" %>
          <%= number_field_tag :stock_quantity, 0, min: 0, inputmode: "numeric", required: true,
                class: "block w-full rounded-md border border-neutral-300 px-3 py-2 text-sm focus:border-neutral-900 focus:outline-none" %>
        </div>
        <div>
          <%= label_tag :weight_oz, "Shipping weight (oz)", class: "block text-sm font-medium text-neutral-700 mb-1" %>
          <%= number_field_tag :weight_oz, 0, min: 0, inputmode: "numeric",
                class: "block w-full rounded-md border border-neutral-300 px-3 py-2 text-sm focus:border-neutral-900 focus:outline-none" %>
          <p class="mt-1 text-xs text-neutral-400">0 assumes <%= Variant::DEFAULT_WEIGHT_OZ %> oz.</p>
        </div>
      </div>

      <div class="mt-5">
        <%= submit_tag "Add selected sizes",
              class: "rounded-md bg-neutral-900 px-4 py-2 text-sm font-semibold text-white hover:bg-neutral-700",
              data: { disable_with: "Adding…" } %>
      </div>
    <% end %>
  <% else %>
    <p class="mt-4 text-sm text-neutral-500">
      Every size is already on this product. Use <strong>Add variant</strong> for a non-size option.
    </p>
  <% end %>
</div>
