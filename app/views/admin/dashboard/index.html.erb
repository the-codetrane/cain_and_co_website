<% content_for :title, "Dashboard · Admin" %>

<h1 class="text-2xl font-bold tracking-tight">Dashboard</h1>
<p class="mt-2 text-neutral-500">Welcome back. Manage the site from here.</p>

<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <%# Live admin sections %>
  <%= link_to admin_shows_path, class: "block rounded-xl border border-neutral-200 bg-white p-6 hover:border-neutral-400" do %>
    <div class="flex items-center justify-between">
      <h2 class="font-semibold">Shows</h2>
      <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs text-emerald-700">Live</span>
    </div>
    <p class="mt-2 text-sm text-neutral-500">Sync &amp; feature tour dates</p>
  <% end %>

  <%= link_to admin_subscribers_path, class: "block rounded-xl border border-neutral-200 bg-white p-6 hover:border-neutral-400" do %>
    <div class="flex items-center justify-between">
      <h2 class="font-semibold">Email list</h2>
      <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs text-emerald-700">Live</span>
    </div>
    <p class="mt-2 text-sm text-neutral-500">Subscribers &amp; CSV export</p>
  <% end %>

  <%= link_to admin_newsletters_path, class: "block rounded-xl border border-neutral-200 bg-white p-6 hover:border-neutral-400" do %>
    <div class="flex items-center justify-between">
      <h2 class="font-semibold">Newsletter</h2>
      <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs text-emerald-700">Live</span>
    </div>
    <p class="mt-2 text-sm text-neutral-500">Compose, AI drafts &amp; send to subscribers</p>
  <% end %>

  <%= link_to admin_products_path, class: "block rounded-xl border border-neutral-200 bg-white p-6 hover:border-neutral-400" do %>
    <div class="flex items-center justify-between">
      <h2 class="font-semibold">Products</h2>
      <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs text-emerald-700">Live</span>
    </div>
    <p class="mt-2 text-sm text-neutral-500">Merch catalog &amp; variants</p>
  <% end %>

  <%= link_to admin_orders_path, class: "block rounded-xl border border-neutral-200 bg-white p-6 hover:border-neutral-400" do %>
    <div class="flex items-center justify-between">
      <h2 class="font-semibold">Orders</h2>
      <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs text-emerald-700">Live</span>
    </div>
    <p class="mt-2 text-sm text-neutral-500">Fulfillment queue &amp; order history</p>
  <% end %>

  <%= link_to admin_photos_path, class: "block rounded-xl border border-neutral-200 bg-white p-6 hover:border-neutral-400" do %>
    <div class="flex items-center justify-between">
      <h2 class="font-semibold">Photos</h2>
      <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs text-emerald-700">Live</span>
    </div>
    <p class="mt-2 text-sm text-neutral-500">Band photo gallery on the About page</p>
  <% end %>

  <%= link_to admin_videos_path, class: "block rounded-xl border border-neutral-200 bg-white p-6 hover:border-neutral-400" do %>
    <div class="flex items-center justify-between">
      <h2 class="font-semibold">Videos</h2>
      <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs text-emerald-700">Live</span>
    </div>
    <p class="mt-2 text-sm text-neutral-500">YouTube videos synced from @cainandcoband</p>
  <% end %>

  <%# Upcoming phases %>
  <% [
       ["Notifications", "Push to installed fans", "Phase 7"],
     ].each do |title, desc, phase| %>
    <div class="rounded-xl border border-neutral-200 bg-white p-6">
      <div class="flex items-center justify-between">
        <h2 class="font-semibold"><%= title %></h2>
        <span class="rounded-full bg-neutral-100 px-2.5 py-1 text-xs text-neutral-500"><%= phase %></span>
      </div>
      <p class="mt-2 text-sm text-neutral-500"><%= desc %></p>
    </div>
  <% end %>
</div>
