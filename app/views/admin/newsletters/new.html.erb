<% content_for :title, "New newsletter · Admin" %>

<div class="mb-6">
  <%= link_to "← Newsletters", admin_newsletters_path, class: "text-sm text-neutral-500 hover:text-neutral-900" %>
  <h1 class="mt-2 text-2xl font-bold tracking-tight">New newsletter</h1>
</div>

<%# Start with AI — creates a draft and generates the body with Claude. %>
<div class="mb-8 rounded-xl border border-neutral-200 bg-white p-6">
  <h2 class="font-semibold">Start with AI</h2>
  <p class="mt-1 text-sm text-neutral-500">
    Give it a subject and an optional topic; Claude drafts the body from your upcoming shows. You'll be able to edit before sending.
  </p>
  <% field = "block w-full rounded-md border border-neutral-300 px-3 py-2 text-sm focus:border-neutral-900 focus:outline-none" %>
  <%= form_with url: generate_admin_newsletters_path, method: :post, class: "mt-4 space-y-3" do |f| %>
    <% if @newsletter.errors.any? %>
      <div class="rounded-md bg-red-100 border border-red-300 px-4 py-2 text-sm text-red-900">
        <%= @newsletter.errors.full_messages.to_sentence %>
      </div>
    <% end %>
    <div>
      <%= f.label "newsletter[subject]", "Subject", class: "block text-sm font-medium text-neutral-700 mb-1" %>
      <%= f.text_field "newsletter[subject]", value: @newsletter.subject, class: field, required: true %>
    </div>
    <div>
      <%= f.label "newsletter[ai_topic]", "Topic (optional)", class: "block text-sm font-medium text-neutral-700 mb-1" %>
      <%= f.text_area "newsletter[ai_topic]", value: @newsletter_ai_topic, rows: 2,
            placeholder: "e.g. new single out Friday + summer tour dates", class: field %>
    </div>
    <%= f.submit "Generate with AI", class: "rounded-md bg-neutral-900 px-4 py-2 text-sm font-semibold text-white hover:bg-neutral-700 cursor-pointer" %>
  <% end %>
</div>

<div class="mb-3 text-sm font-semibold text-neutral-500">Or write it yourself</div>
<%= render "form", newsletter: @newsletter %>
