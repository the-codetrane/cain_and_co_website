<% content_for :head do %>
  <%# Trix editor styling — not part of the global manifest. %>
  <%= stylesheet_link_tag "actiontext" %>
<% end %>

<%= form_with model: [:admin, newsletter] do |f| %>
  <% if newsletter.errors.any? %>
    <div class="mb-5 rounded-md bg-red-100 border border-red-300 px-4 py-3 text-sm text-red-900">
      <p class="font-semibold"><%= pluralize(newsletter.errors.count, "error") %> prevented saving:</p>
      <ul class="mt-1 list-disc list-inside">
        <% newsletter.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <% field = "block w-full rounded-md border border-neutral-300 px-3 py-2 text-sm focus:border-neutral-900 focus:outline-none" %>
  <% label = "block text-sm font-medium text-neutral-700 mb-1" %>

  <div class="space-y-5">
    <div>
      <%= f.label :subject, class: label %>
      <%= f.text_field :subject, class: field, required: true %>
    </div>

    <div>
      <%= f.label :body, "Body", class: label %>
      <%= f.rich_text_area :body, class: "trix-content block w-full rounded-md border border-neutral-300" %>
    </div>
  </div>

  <div class="mt-6 flex items-center gap-3">
    <%= f.submit "Save draft", class: "rounded-md bg-neutral-900 px-4 py-2 text-sm font-semibold text-white hover:bg-neutral-700" %>
    <%= link_to "Cancel", (newsletter.persisted? ? admin_newsletter_path(newsletter) : admin_newsletters_path),
          class: "admin-tap text-sm text-neutral-500 hover:text-neutral-900" %>
  </div>
<% end %>
