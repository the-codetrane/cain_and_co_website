<% content_for :title, "Order ##{@order.id} · Admin" %>

<div class="flex flex-wrap items-start justify-between gap-3">
  <div>
    <%= link_to "← Orders", admin_orders_path, class: "admin-tap text-sm text-neutral-500 hover:text-neutral-900" %>
    <h1 class="mt-2 text-2xl font-bold tracking-tight">Order #<%= @order.id %></h1>
  </div>
  <% if @order.paid? %>
    <%= button_to "Mark fulfilled", fulfill_admin_order_path(@order), method: :patch,
          class: "rounded-md bg-emerald-700 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800" %>
  <% end %>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <%# Order details %>
  <div class="rounded-xl border border-neutral-200 bg-white p-4 md:p-6">
    <h2 class="font-semibold mb-4">Details</h2>
    <dl class="space-y-2 text-sm">
      <div class="flex justify-between gap-4">
        <dt class="text-neutral-500">Status</dt>
        <dd>
          <span class="rounded-full px-2.5 py-1 text-xs <%= @order.paid? ? 'bg-amber-100 text-amber-700' : @order.fulfilled? ? 'bg-emerald-100 text-emerald-700' : @order.canceled? ? 'bg-red-100 text-red-600' : 'bg-neutral-100 text-neutral-500' %>">
            <%= @order.status.capitalize %>
          </span>
        </dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-neutral-500">Placed</dt>
        <dd class="text-right"><%= @order.created_at.strftime("%b %-d, %Y at %-I:%M %p") %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-neutral-500">Buyer name</dt>
        <dd class="min-w-0 break-words text-right"><%= @order.buyer_name.presence || "—" %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-neutral-500">Buyer email</dt>
        <dd class="min-w-0 break-words text-right"><%= @order.buyer_email.presence || "—" %></dd>
      </div>
      <% if @order.stripe_checkout_session_id.present? %>
        <div class="flex justify-between gap-4">
          <dt class="text-neutral-500">Stripe session</dt>
          <dd class="min-w-0 font-mono text-xs truncate md:max-w-[200px]"><%= @order.stripe_checkout_session_id %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <%# Shipping address %>
  <div class="rounded-xl border border-neutral-200 bg-white p-4 md:p-6">
    <h2 class="font-semibold mb-4">Ship to</h2>
    <% if @order.shipping_address.present? %>
      <address class="text-sm not-italic leading-relaxed">
        <%= @order.shipping_name %><br>
        <%= @order.shipping_address1 %><br>
        <% if @order.shipping_address2.present? %><%= @order.shipping_address2 %><br><% end %>
        <%= [@order.shipping_city, @order.shipping_state, @order.shipping_zip].compact_blank.join(", ") %><br>
        <%= @order.shipping_country %>
      </address>
    <% else %>
      <p class="text-sm text-neutral-400">No shipping address — pending Stripe checkout.</p>
    <% end %>
  </div>
</div>

<%# Line items %>
<div class="mt-6 rounded-xl border border-neutral-200 bg-white overflow-hidden">
  <div class="px-4 py-4 border-b border-neutral-200 md:px-6">
    <h2 class="font-semibold">Items</h2>
  </div>
  <table class="w-full text-sm">
    <tbody class="divide-y divide-neutral-100">
      <% @order.order_items.each do |item| %>
        <tr>
          <td class="px-4 py-3 md:px-6">
            <%= item.variant_name %>
            <p class="text-xs text-neutral-500 md:hidden">$<%= "%.2f" % (item.unit_price_cents / 100.0) %> each</p>
          </td>
          <td class="whitespace-nowrap px-2 py-3 text-neutral-500 md:px-6">× <%= item.quantity %></td>
          <td class="hidden px-6 py-3 text-neutral-500 md:table-cell">$<%= "%.2f" % (item.unit_price_cents / 100.0) %> each</td>
          <td class="px-4 py-3 text-right font-medium md:px-6">$<%= "%.2f" % (item.subtotal_cents / 100.0) %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot class="border-t border-neutral-200 bg-neutral-50 text-sm">
      <tr>
        <td colspan="2" class="px-4 py-2 text-neutral-500 md:px-6">Subtotal</td>
        <td class="hidden md:table-cell"></td>
        <td class="px-4 py-2 text-right md:px-6">$<%= "%.2f" % (@order.subtotal_cents / 100.0) %></td>
      </tr>
      <tr>
        <td colspan="2" class="px-4 py-2 text-neutral-500 md:px-6">Shipping</td>
        <td class="hidden md:table-cell"></td>
        <td class="px-4 py-2 text-right md:px-6">$<%= "%.2f" % (@order.shipping_cents / 100.0) %></td>
      </tr>
      <tr class="font-semibold">
        <td colspan="2" class="px-4 py-3 md:px-6">Total</td>
        <td class="hidden md:table-cell"></td>
        <td class="px-4 py-3 text-right md:px-6">$<%= "%.2f" % @order.total_dollars %></td>
      </tr>
    </tfoot>
  </table>
</div>
