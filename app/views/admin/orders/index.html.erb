<% content_for :title, "Orders · Admin" %>

<h1 class="text-2xl font-bold tracking-tight">Orders</h1>

<% if @needs_fulfillment.any? %>
  <section class="mt-8">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-neutral-500">
      Needs fulfillment (<%= @needs_fulfillment.count %>)
    </h2>
    <div class="mt-3 overflow-hidden rounded-xl border border-amber-200 bg-white">
      <table class="block w-full text-sm md:table">
        <thead class="hidden border-b border-neutral-200 bg-amber-50 text-left text-xs font-semibold uppercase tracking-wider text-neutral-500 md:table-header-group">
          <tr>
            <th class="px-4 py-3">Order</th>
            <th class="px-4 py-3">Buyer</th>
            <th class="px-4 py-3">Items</th>
            <th class="px-4 py-3">Total</th>
            <th class="px-4 py-3">Placed</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="block divide-y divide-neutral-100 md:table-row-group">
          <% @needs_fulfillment.each do |order| %>
            <tr class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-3 gap-y-1 p-4 md:table-row md:p-0">
              <td class="col-start-1 row-start-1 font-mono text-xs text-neutral-400 md:px-4 md:py-3">#<%= order.id %></td>
              <td class="col-span-2 row-start-2 min-w-0 break-words md:px-4 md:py-3">
                <div class="font-medium"><%= order.buyer_name %></div>
                <div class="text-neutral-400"><%= order.buyer_email %></div>
              </td>
              <% item_count = order.order_items.sum { |i| i.quantity } %>
              <td class="col-start-1 row-start-3 text-neutral-500 md:px-4 md:py-3"><%= item_count %><span class="md:hidden"> <%= "item".pluralize(item_count) %></span></td>
              <td class="col-start-2 row-start-1 text-right md:px-4 md:py-3 md:text-left">$<%= "%.2f" % order.total_dollars %></td>
              <td class="col-start-2 row-start-3 text-right text-neutral-500 md:px-4 md:py-3 md:text-left"><%= order.created_at.strftime("%b %-d") %></td>
              <td class="col-span-2 row-start-4 mt-2 flex items-center justify-between md:mt-0 md:table-cell md:px-4 md:py-3 md:text-right">
                <%= link_to "View", admin_order_path(order), class: "admin-tap text-neutral-500 hover:text-neutral-900 md:mr-3" %>
                <%= button_to "Mark fulfilled", fulfill_admin_order_path(order), method: :patch,
                      class: "rounded-md bg-emerald-700 px-3 py-1 text-xs font-semibold text-white hover:bg-emerald-800" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% else %>
  <div class="mt-8 rounded-xl border border-neutral-200 bg-white p-8 text-center">
    <p class="text-neutral-500">No orders awaiting fulfillment.</p>
  </div>
<% end %>

<section class="mt-10">
  <h2 class="text-sm font-semibold uppercase tracking-widest text-neutral-500">Recent orders</h2>
  <% if @recent.any? %>
    <div class="mt-3 overflow-hidden rounded-xl border border-neutral-200 bg-white">
      <table class="block w-full text-sm md:table">
        <thead class="hidden border-b border-neutral-200 bg-neutral-50 text-left text-xs font-semibold uppercase tracking-wider text-neutral-500 md:table-header-group">
          <tr>
            <th class="px-4 py-3">Order</th>
            <th class="px-4 py-3">Buyer</th>
            <th class="px-4 py-3">Total</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3">Placed</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="block divide-y divide-neutral-100 md:table-row-group">
          <% @recent.each do |order| %>
            <tr class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1 p-4 md:table-row md:p-0">
              <td class="col-start-1 row-start-1 font-mono text-xs text-neutral-400 md:px-4 md:py-3">#<%= order.id %></td>
              <td class="col-start-1 row-start-2 min-w-0 break-words md:px-4 md:py-3"><%= order.buyer_name.presence || order.buyer_email %></td>
              <td class="col-start-2 row-start-1 text-right md:px-4 md:py-3 md:text-left">$<%= "%.2f" % order.total_dollars %></td>
              <td class="col-start-2 row-start-2 text-right md:px-4 md:py-3 md:text-left">
                <span class="rounded-full px-2 py-0.5 text-xs <%= order.paid? ? 'bg-amber-100 text-amber-700' : order.fulfilled? ? 'bg-emerald-100 text-emerald-700' : order.canceled? ? 'bg-red-100 text-red-600' : 'bg-neutral-100 text-neutral-500' %>">
                  <%= order.status.capitalize %>
                </span>
              </td>
              <td class="col-start-1 row-start-3 text-neutral-500 md:px-4 md:py-3"><%= order.created_at.strftime("%b %-d") %></td>
              <td class="col-start-2 row-start-3 text-right md:px-4 md:py-3">
                <%= link_to "View", admin_order_path(order), class: "admin-tap text-neutral-500 hover:text-neutral-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="mt-3 text-sm text-neutral-500">No orders yet.</p>
  <% end %>
</section>
