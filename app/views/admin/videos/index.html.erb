<% content_for :title, "Videos · Admin" %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold tracking-tight">Videos</h1>
  <%= button_to "Sync from YouTube", sync_admin_videos_path, method: :post,
        class: "rounded-md bg-neutral-900 px-3 py-1.5 text-sm font-semibold text-white hover:bg-neutral-700" %>
</div>
<p class="mt-1 text-xs text-neutral-500">Synced automatically every 6 hours from <a href="https://www.youtube.com/@cainandcoband" target="_blank" rel="noopener" class="underline hover:text-neutral-800">@cainandcoband</a>. Toggle visibility to control what appears on the About page. Mark 2–3 full-song live clips <strong>EPK</strong> to lead the booking page (best first: newest EPK clip shows first).</p>

<% if @videos.any? %>
  <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
    <% @videos.each do |video| %>
      <div class="rounded-xl border border-neutral-200 bg-white overflow-hidden">
        <% if video.thumbnail_url.present? %>
          <a href="https://www.youtube.com/watch?v=<%= video.youtube_id %>" target="_blank" rel="noopener">
            <img src="<%= video.thumbnail_url %>" alt="<%= video.title %>"
                 loading="lazy" decoding="async"
                 class="w-full aspect-video object-cover">
          </a>
        <% end %>
        <div class="p-3">
          <p class="text-sm font-semibold leading-snug line-clamp-2"><%= video.title %></p>
          <div class="mt-1 flex items-center gap-2 text-xs text-neutral-400">
            <span><%= video.published_at.strftime("%b %-d, %Y") %></span>
            <% if video.short? %>
              <span class="rounded bg-neutral-100 px-1.5 py-0.5 font-medium text-neutral-500">Short</span>
            <% end %>
          </div>
          <div class="mt-3 flex gap-2">
            <%= button_to video.epk? ? "★ EPK" : "☆ EPK",
                  admin_video_path(video),
                  method: :patch,
                  params: { video: { epk: !video.epk? } },
                  class: video.epk? \
                    ? "rounded-md bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800" \
                    : "rounded-md border border-neutral-300 px-3 py-1 text-xs font-semibold text-neutral-600 hover:bg-neutral-50" %>
            <%= button_to video.visible? ? "Hide" : "Show",
                  admin_video_path(video),
                  method: :patch,
                  params: { video: { visible: !video.visible? } },
                  class: video.visible? \
                    ? "rounded-md border border-neutral-300 px-3 py-1 text-xs font-semibold text-neutral-700 hover:bg-neutral-50" \
                    : "rounded-md bg-neutral-900 px-3 py-1 text-xs font-semibold text-white hover:bg-neutral-700" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="mt-8 rounded-xl border border-neutral-200 bg-white p-10 text-center">
    <p class="text-neutral-500">No videos yet.</p>
    <%= button_to "Sync from YouTube now", sync_admin_videos_path, method: :post,
          class: "mt-3 inline-block rounded-md bg-neutral-900 px-4 py-2 text-sm font-semibold text-white hover:bg-neutral-700" %>
  </div>
<% end %>
