<%# One account in the Admin › Users list. Re-rendered on its own (Turbo Stream replace
    by dom id) when admin access changes, so the rest of the page is left alone. %>
<div id="<%= dom_id(user) %>" class="flex flex-wrap items-center gap-3 px-4 py-3">
  <div class="min-w-0 basis-full md:flex-1 md:basis-0">
    <p class="font-medium truncate"><%= user.email_address %></p>
    <p class="text-xs text-neutral-500">joined <%= user.created_at.to_date.to_fs(:long) %></p>
  </div>
  <%= tag.span (user.admin? ? "admin" : "no access"),
        class: "rounded-full px-2.5 py-0.5 text-xs font-semibold #{user.admin? ? 'bg-emerald-100 text-emerald-700' : 'bg-neutral-100 text-neutral-500'}" %>
  <% if user == Current.user %>
    <span class="text-xs text-neutral-400">You</span>
  <% elsif user.admin? %>
    <%= button_to "Remove admin", admin_user_path(user), method: :patch,
          params: { user: { admin: false } },
          form: { data: { turbo_confirm: "Remove admin access from #{user.email_address}?" } },
          class: "rounded-md border border-red-200 px-2.5 py-1 text-xs font-semibold text-red-600 hover:bg-red-50" %>
  <% else %>
    <%= button_to "Make admin", admin_user_path(user), method: :patch,
          params: { user: { admin: true } },
          form: { data: { turbo_confirm: "Give #{user.email_address} full admin access?" } },
          class: "rounded-md border border-neutral-300 px-2.5 py-1 text-xs font-semibold text-neutral-600 hover:bg-neutral-50" %>
  <% end %>
</div>
