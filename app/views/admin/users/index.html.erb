<% content_for :title, "Users · Admin" %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold tracking-tight">Users</h1>
  <%= link_to "Invite user", new_admin_invitation_path,
        class: "rounded-md bg-neutral-900 px-3 py-1.5 text-sm font-semibold text-white hover:bg-neutral-700" %>
</div>

<div class="mt-6 overflow-hidden rounded-xl border border-neutral-200 bg-white divide-y divide-neutral-200">
  <%= render partial: "admin/users/row", collection: @users, as: :user %>
</div>

<% if @invitations.any? %>
  <h2 class="mt-10 text-lg font-bold tracking-tight">Invitations</h2>
  <p class="mt-1 text-sm text-neutral-500">To send a new link, invite the same address again.</p>

  <div class="mt-4 overflow-hidden rounded-xl border border-neutral-200 bg-white divide-y divide-neutral-200">
    <% @invitations.each do |invitation| %>
      <div id="<%= dom_id(invitation) %>" class="flex flex-wrap items-center gap-3 px-4 py-3">
        <div class="min-w-0 basis-full md:flex-1 md:basis-0">
          <p class="font-medium truncate"><%= invitation.email %></p>
          <p class="text-xs text-neutral-500">
            sent <%= invitation.sent_at.to_date.to_fs(:long) %>
            <% unless invitation.expired? %> · expires <%= invitation.expires_at.to_date.to_fs(:long) %><% end %>
            <% if invitation.admin? %> · will be an admin<% end %>
          </p>
        </div>
        <%= tag.span (invitation.expired? ? "expired" : "pending"),
              class: "rounded-full px-2.5 py-0.5 text-xs font-semibold #{invitation.expired? ? 'bg-neutral-100 text-neutral-500' : 'bg-amber-100 text-amber-700'}" %>
        <%= button_to "Cancel invite", admin_invitation_path(invitation), method: :delete,
              form: { data: { turbo_confirm: "Cancel the invitation to #{invitation.email}?" } },
              class: "rounded-md border border-red-200 px-2.5 py-1 text-xs font-semibold text-red-600 hover:bg-red-50" %>
      </div>
    <% end %>
  </div>
<% end %>
