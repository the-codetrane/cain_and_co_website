<% content_for :title, "Photo Order · Admin" %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold tracking-tight">Photo Order</h1>
    <p class="mt-1 text-sm text-neutral-500">Drag photos to set the display order on the About page.</p>
  </div>
  <%= link_to "← All photos", admin_photos_path,
        class: "rounded-md border border-neutral-300 px-3 py-1.5 text-sm font-medium text-neutral-700 hover:bg-neutral-50" %>
</div>

<% if @photos.any? %>
  <div class="mt-6 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 cursor-grab active:cursor-grabbing"
       data-controller="photo-sort"
       data-photo-sort-url-value="<%= reorder_admin_photos_path %>">
    <% @photos.each do |photo| %>
      <div class="group relative rounded-xl overflow-hidden border border-neutral-200 bg-white select-none"
           data-photo-id="<%= photo.id %>">
        <% if photo.image.attached? %>
          <%= image_tag photo.image_src, class: "w-full aspect-square object-cover pointer-events-none", loading: "lazy", alt: photo.caption.presence || "Photo #{photo.position}" %>
        <% else %>
          <div class="w-full aspect-square bg-neutral-100 flex items-center justify-center">
            <span class="text-xs text-neutral-400">No image</span>
          </div>
        <% end %>
        <div class="absolute top-1.5 left-1.5">
          <span class="rounded bg-neutral-900/70 px-1.5 py-0.5 text-[10px] font-semibold text-white">#<%= photo.position %></span>
        </div>
        <div class="absolute top-1.5 right-1.5 opacity-0 group-hover:opacity-100 transition-opacity">
          <span class="rounded bg-neutral-900/70 px-1.5 py-0.5 text-[10px] text-white select-none">⠿</span>
        </div>
        <% if photo.caption.present? %>
          <p class="px-2 py-1.5 text-xs text-neutral-600 truncate"><%= photo.caption %></p>
        <% end %>
      </div>
    <% end %>
  </div>
  <p class="mt-4 text-xs text-neutral-500">Order saves automatically. Position numbers update on next page load.</p>
<% else %>
  <div class="mt-8 rounded-xl border border-neutral-200 bg-white p-10 text-center">
    <p class="text-neutral-500">No visible photos to order.</p>
    <%= link_to "Go to photos →", admin_photos_path, class: "mt-3 inline-block text-sm font-semibold hover:underline" %>
  </div>
<% end %>
