<div class="group relative rounded-xl overflow-hidden border border-neutral-200 bg-white">
  <label class="absolute top-0 right-0 z-20 flex size-11 cursor-pointer items-center justify-center md:top-1.5 md:right-1.5 md:size-auto">
    <input type="checkbox"
           name="photo_ids[]"
           value="<%= photo.id %>"
           form="bulk-photos-form"
           data-bulk-select-target="checkbox"
           data-action="change->bulk-select#toggle"
           class="size-6 rounded border-white/50 bg-white/80 accent-neutral-900 shadow-sm md:size-4">
  </label>
  <% if photo.image.attached? %>
    <%= image_tag media_src(photo.display(:admin_grid)), class: "w-full aspect-square object-cover", loading: "lazy", alt: photo.caption.presence || "Photo #{photo.position}" %>
  <% else %>
    <div class="w-full aspect-square bg-neutral-100 flex items-center justify-center">
      <span class="text-xs text-neutral-400">No image</span>
    </div>
  <% end %>
  <div class="absolute top-1.5 left-1.5 z-10 flex gap-1">
    <span class="rounded bg-neutral-900/70 px-1.5 py-0.5 text-[10px] font-semibold text-white">#<%= photo.position %></span>
    <% if photo.epk? %>
      <span class="rounded bg-amber-500/90 px-1.5 py-0.5 text-[10px] font-semibold text-white">EPK</span>
    <% end %>
    <% unless photo.published? %>
      <span class="rounded bg-neutral-500/80 px-1.5 py-0.5 text-[10px] font-semibold text-white">Hidden</span>
    <% end %>
  </div>
  <% if photo.caption.present? %>
    <p class="px-2 py-1.5 text-xs text-neutral-600 truncate"><%= photo.caption %></p>
  <% end %>
  <%# Always visible under the photo on phones, where there's no hover to reveal it.
      From md up it's the overlay, kept last so it doesn't push the caption down. %>
  <div class="flex gap-2 p-2 md:absolute md:inset-0 md:flex-col md:items-center md:justify-center md:bg-neutral-900/60 md:p-0 md:opacity-0 md:transition-opacity md:group-hover:opacity-100 md:focus-within:opacity-100">
    <%= link_to "Edit", edit_admin_photo_path(photo),
          class: "flex-1 rounded-md border border-neutral-300 bg-white px-3 py-1.5 text-center text-xs font-semibold text-neutral-900 hover:bg-neutral-100 md:flex-none md:border-0" %>
    <%= button_to "Delete", admin_photo_path(photo), method: :delete,
          form: { class: "flex-1 md:flex-none", data: { turbo_confirm: "Remove this photo?" } },
          class: "w-full rounded-md bg-red-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-red-700 md:w-auto" %>
  </div>
</div>
