<% content_for :title, "Photos · Admin" %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold tracking-tight">Photos</h1>
  <%= link_to "Add photo", new_admin_photo_path,
        class: "rounded-md bg-neutral-900 px-3 py-1.5 text-sm font-semibold text-white hover:bg-neutral-700" %>
</div>

<% if @photos.any? %>
  <div class="mt-6 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
    <% @photos.each do |photo| %>
      <div class="group relative rounded-xl overflow-hidden border border-neutral-200 bg-white">
        <% if photo.image.attached? %>
          <%= image_tag photo.image, class: "w-full aspect-square object-cover", alt: photo.caption.presence || "Photo #{photo.position}" %>
        <% else %>
          <div class="w-full aspect-square bg-neutral-100 flex items-center justify-center">
            <span class="text-xs text-neutral-400">No image</span>
          </div>
        <% end %>
        <div class="absolute inset-0 bg-neutral-900/60 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center gap-2">
          <%= link_to "Edit", edit_admin_photo_path(photo),
                class: "rounded-md bg-white px-3 py-1.5 text-xs font-semibold text-neutral-900 hover:bg-neutral-100" %>
          <%= button_to "Delete", admin_photo_path(photo), method: :delete,
                form: { data: { turbo_confirm: "Remove this photo?" } },
                class: "rounded-md bg-red-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-red-700" %>
        </div>
        <div class="absolute top-1.5 left-1.5 flex gap-1">
          <span class="rounded bg-neutral-900/70 px-1.5 py-0.5 text-[10px] font-semibold text-white">#<%= photo.position %></span>
          <% unless photo.published? %>
            <span class="rounded bg-neutral-500/80 px-1.5 py-0.5 text-[10px] font-semibold text-white">Hidden</span>
          <% end %>
        </div>
        <% if photo.caption.present? %>
          <p class="px-2 py-1.5 text-xs text-neutral-600 truncate"><%= photo.caption %></p>
        <% end %>
      </div>
    <% end %>
  </div>
  <p class="mt-4 text-xs text-neutral-500">Hover a photo to edit or delete. Use the position field to control display order.</p>
<% else %>
  <div class="mt-8 rounded-xl border border-neutral-200 bg-white p-10 text-center">
    <p class="text-neutral-500">No photos yet.</p>
    <%= link_to "Add your first photo →", new_admin_photo_path, class: "mt-3 inline-block text-sm font-semibold hover:underline" %>
  </div>
<% end %>
