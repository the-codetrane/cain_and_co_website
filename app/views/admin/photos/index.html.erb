<% content_for :title, "Photos · Admin" %>

<div data-controller="bulk-select" data-bulk-select-total-value="<%= @filtered_count %>">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold tracking-tight">Photos</h1>
    <div class="flex gap-2">
      <% if @filter == "visible" %>
        <%= link_to "⠿ Reorder", visible_admin_photos_path,
              class: "rounded-md border border-neutral-300 px-3 py-1.5 text-sm font-medium text-neutral-700 hover:bg-neutral-50" %>
      <% end %>
      <%= link_to "Add photo", new_admin_photo_path,
            class: "rounded-md bg-neutral-900 px-3 py-1.5 text-sm font-semibold text-white hover:bg-neutral-700" %>
    </div>
  </div>

  <% tab = ->(label, value) {
       active = @filter == value
       link_to label, (value ? admin_photos_path(filter: value) : admin_photos_path),
         class: "px-3 py-1.5 rounded-md text-sm font-medium transition-colors #{active ? 'bg-neutral-900 text-white' : 'text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100'}"
     } %>
  <div class="mt-4 flex gap-1">
    <%= tab.call("All (#{@counts[:all]})", nil) %>
    <%= tab.call("Visible (#{@counts[:visible]})", "visible") %>
    <%= tab.call("Hidden (#{@counts[:hidden]})", "hidden") %>
  </div>

  <%= form_with url: bulk_update_admin_photos_path, method: :patch,
        id: "bulk-photos-form",
        data: { "bulk-select-target": "form" } do %>
    <%= hidden_field_tag :filter, @filter %>
    <input type="hidden" name="published" data-bulk-select-target="published" value="">
    <input type="hidden" name="select_all" data-bulk-select-target="allField" value="">

    <div data-bulk-select-target="bar" class="hidden mt-4 flex flex-wrap items-center gap-x-3 rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-2.5">
      <span class="text-sm font-medium text-neutral-700" data-bulk-select-target="count">0 selected</span>
      <span class="h-4 w-px bg-neutral-300"></span>
      <button type="button" data-action="click->bulk-select#publish"
              class="text-sm font-semibold text-neutral-900 hover:underline">Show</button>
      <button type="button" data-action="click->bulk-select#hide"
              class="text-sm font-semibold text-neutral-900 hover:underline">Hide</button>
      <div class="ml-auto flex gap-3">
        <button type="button" data-action="click->bulk-select#selectAll"
                class="text-xs text-neutral-500 hover:text-neutral-900">Select all</button>
        <button type="button" data-action="click->bulk-select#deselectAll"
                class="text-xs text-neutral-500 hover:text-neutral-900">Deselect all</button>
      </div>
    </div>
  <% end %>

  <% if @photos.any? %>
    <div id="photos_grid" class="mt-6 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 md:gap-4">
      <%= render partial: "card", collection: @photos, as: :photo %>
    </div>
    <%= render "next_page" if @next_page %>
    <p class="mt-4 hidden text-xs text-neutral-500 md:block">Hover a photo to edit or delete. Use the position field to control display order.</p>
  <% else %>
    <div class="mt-8 rounded-xl border border-neutral-200 bg-white p-10 text-center">
      <% if @filter == "visible" %>
        <p class="text-neutral-500">No visible photos.</p>
      <% elsif @filter == "hidden" %>
        <p class="text-neutral-500">No hidden photos.</p>
      <% else %>
        <p class="text-neutral-500">No photos yet.</p>
        <%= link_to "Add your first photo →", new_admin_photo_path, class: "mt-3 inline-block text-sm font-semibold hover:underline" %>
      <% end %>
    </div>
  <% end %>
</div>
