<%# Answers the lazy frame in _next_page: adds this page's cards to the grid, then swaps
    the frame for one pointing at the following page, or removes it after the last. %>
<%= turbo_frame_tag "photos_next_page" do %>
  <%= turbo_stream.append "photos_grid", partial: "card", collection: @photos, as: :photo %>
  <% if @next_page %>
    <%= turbo_stream.replace "photos_next_page", partial: "next_page" %>
  <% else %>
    <%= turbo_stream.remove "photos_next_page" %>
  <% end %>
<% end %>
