<% content_for :title, "Invite user · Admin" %>

<div class="max-w-md">
  <h1 class="text-2xl font-bold tracking-tight">Invite a user</h1>
  <p class="mt-1 text-sm text-neutral-500">They'll get an email with a link to set a password. The link expires in <%= distance_of_time_in_words(Invitation::EXPIRES_IN) %>.</p>

  <%= form_with model: @invitation, url: admin_invitations_path, method: :post, class: "mt-8" do |f| %>
    <% if @invitation.errors.any? %>
      <div class="mb-5 rounded-md bg-red-100 border border-red-300 px-4 py-3 text-sm text-red-900">
        <ul class="list-disc list-inside">
          <% @invitation.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <%= f.label :email, class: "block text-sm font-medium text-neutral-700 mb-1" %>
    <%= f.email_field :email, required: true,
          class: "block w-full rounded-md border border-neutral-300 px-3 py-2 text-sm focus:border-neutral-900 focus:outline-none" %>

    <label class="mt-4 flex items-center gap-2 text-sm text-neutral-700">
      <%= f.check_box :admin %>
      Grant admin access when they accept
    </label>

    <div class="mt-6 flex items-center gap-3">
      <%= f.submit "Send invitation", class: "rounded-md bg-neutral-900 px-4 py-2 text-sm font-semibold text-white hover:bg-neutral-700 cursor-pointer" %>
      <%= link_to "Cancel", admin_users_path, class: "admin-tap text-sm text-neutral-500 hover:text-neutral-900" %>
    </div>
  <% end %>
</div>
