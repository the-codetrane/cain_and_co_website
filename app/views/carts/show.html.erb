<% content_for :title, "Cart · Cain & Co." %>

<section class="container mx-auto px-5 py-16 max-w-2xl">
  <h1 class="text-4xl font-black tracking-tight">Your cart</h1>

  <% if @cart.new_record? || @cart.empty? %>
    <div class="mt-12 text-center">
      <p class="text-lg text-neutral-400">Your cart is empty.</p>
      <%= link_to "Browse merch →", products_path, class: "mt-4 inline-block text-sm font-semibold text-white hover:underline" %>
    </div>
  <% else %>
    <div class="mt-8 rounded-2xl border border-neutral-800 bg-neutral-900 divide-y divide-neutral-800">
      <% @cart.cart_items.each do |item| %>
        <div class="flex items-center gap-4 p-4">
          <% if item.variant.product.images.attached? %>
            <%= image_tag item.variant.product.images.first.variant(resize_to_fill: [80, 80]),
                  class: "h-16 w-16 flex-shrink-0 rounded-lg object-cover",
                  alt: item.variant.product.name %>
          <% else %>
            <div class="h-16 w-16 flex-shrink-0 rounded-lg bg-neutral-800"></div>
          <% end %>

          <div class="flex-1 min-w-0">
            <p class="font-semibold truncate"><%= item.variant.product.name %></p>
            <p class="text-sm text-neutral-400"><%= item.variant.name %></p>
            <p class="text-sm font-medium mt-1">$<%= "%.2f" % item.variant.price_dollars %></p>
          </div>

          <div class="flex items-center gap-2">
            <%= form_with url: cart_cart_item_path(item), method: :patch, class: "flex items-center gap-1" do |f| %>
              <%= f.number_field :quantity, value: item.quantity, min: 0, max: 99,
                    class: "w-16 rounded-md border border-neutral-700 bg-neutral-800 px-2 py-1 text-center text-sm",
                    data: { action: "change->auto-submit#submit" } %>
              <%= f.submit "Update", class: "hidden" %>
            <% end %>
            <%= button_to cart_cart_item_path(item), method: :delete,
                  class: "text-neutral-500 hover:text-red-400 text-sm ml-2",
                  aria: { label: "Remove" } do %>
              ✕
            <% end %>
          </div>

          <div class="text-right font-semibold min-w-[60px]">
            $<%= "%.2f" % (item.subtotal_cents / 100.0) %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-4 rounded-2xl border border-neutral-800 bg-neutral-900 p-5">
      <div class="flex justify-between text-lg font-bold">
        <span>Subtotal</span>
        <span>$<%= "%.2f" % (@cart.total_cents / 100.0) %></span>
      </div>
      <p class="mt-1 text-xs text-neutral-500">Shipping calculated at checkout</p>
      <%= button_to "Checkout with Stripe →", checkout_path,
            class: "mt-5 w-full rounded-xl bg-white py-3 text-center font-bold text-black hover:bg-neutral-100 transition",
            data: { turbo: false } %>
    </div>

    <div class="mt-4 text-center">
      <%= link_to "← Continue shopping", products_path, class: "text-sm text-neutral-400 hover:text-white" %>
    </div>
  <% end %>
</section>
