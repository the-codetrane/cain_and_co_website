<% content_for :title, "#{@product.name} · Merch · Cain & Co." %>
<% content_for :description, "#{@product.name} — available in the official Cain & Co. store." %>

<section class="container mx-auto px-5 py-16 max-w-4xl">
  <div class="mb-6">
    <%= link_to "← Merch", products_path, class: "text-sm text-neutral-400 hover:text-white" %>
  </div>

  <div class="grid gap-10 md:grid-cols-2">
    <%# Image gallery %>
    <div>
      <% if @product.images.attached? %>
        <div class="aspect-square rounded-2xl overflow-hidden bg-neutral-900">
          <%= image_tag @product.images.first.variant(resize_to_fill: [600, 600]),
                class: "w-full h-full object-cover",
                alt: @product.name %>
        </div>
        <% if @product.images.count > 1 %>
          <div class="mt-3 flex gap-3 overflow-x-auto">
            <% @product.images.each do |image| %>
              <%= image_tag image.variant(resize_to_fill: [100, 100]),
                    class: "h-20 w-20 flex-shrink-0 rounded-lg object-cover border border-neutral-700",
                    alt: @product.name %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="aspect-square rounded-2xl bg-neutral-900 flex items-center justify-center">
          <span class="text-7xl text-neutral-700">🎸</span>
        </div>
      <% end %>
    </div>

    <%# Product info + add to cart %>
    <div>
      <h1 class="text-3xl font-black tracking-tight"><%= @product.name %></h1>

      <% if @product.description.present? %>
        <p class="mt-4 text-neutral-300 leading-relaxed"><%= @product.description %></p>
      <% end %>

      <% variants = @product.variants.to_a %>
      <% in_stock_variants = variants.select(&:in_stock?) %>
      <% if in_stock_variants.any? %>
        <%= form_with url: cart_cart_items_path, method: :post,
                      class: "mt-8 space-y-5",
                      data: { controller: "variant-picker" } do %>
          <% if variants.many? %>
            <fieldset>
              <legend class="block text-sm font-medium text-neutral-300 mb-2">
                <%= variants.all?(&:size?) ? "Select size" : "Select option" %>
              </legend>
              <div class="flex flex-wrap gap-2">
                <% variants.each do |variant| %>
                  <% if variant.in_stock? %>
                    <label class="cursor-pointer select-none rounded-xl border border-neutral-700 px-4 py-2.5 text-sm font-semibold text-neutral-200 transition-colors hover:border-neutral-400 has-[:checked]:border-white has-[:checked]:bg-white has-[:checked]:text-neutral-900 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-white has-[:focus-visible]:ring-offset-2 has-[:focus-visible]:ring-offset-neutral-950">
                      <%= radio_button_tag :variant_id, variant.id,
                            variant == in_stock_variants.first,
                            required: true,
                            class: "sr-only",
                            data: {
                              variant_picker_target: "option",
                              action: "change->variant-picker#update",
                              price: "$%.2f" % variant.price_dollars
                            } %>
                      <%= variant.name %>
                    </label>
                  <% else %>
                    <span class="cursor-not-allowed rounded-xl border border-neutral-800 px-4 py-2.5 text-sm font-semibold text-neutral-600 line-through"
                          title="Sold out">
                      <%= variant.name %>
                    </span>
                  <% end %>
                <% end %>
              </div>
            </fieldset>

            <p class="text-2xl font-bold" data-variant-picker-target="price">
              $<%= "%.2f" % in_stock_variants.first.price_dollars %>
            </p>
          <% else %>
            <% variant = in_stock_variants.first %>
            <%= hidden_field_tag :variant_id, variant.id %>
            <p class="text-2xl font-bold">$<%= "%.2f" % variant.price_dollars %></p>
          <% end %>

          <button type="submit"
                  data-variant-picker-target="submit"
                  class="w-full rounded-full bg-white px-6 py-3.5 font-semibold text-neutral-900 hover:bg-neutral-200 transition-colors disabled:cursor-not-allowed disabled:bg-neutral-700 disabled:text-neutral-400">
            Add to cart
          </button>
        <% end %>
      <% else %>
        <div class="mt-8">
          <p class="text-lg font-semibold text-red-400">Out of stock</p>
          <p class="mt-1 text-sm text-neutral-400">Check back soon, or join the newsletter to hear about restocks.</p>
        </div>
      <% end %>

      <% if variants.many? && in_stock_variants.size < variants.size %>
        <p class="mt-3 text-xs text-neutral-500">Struck-through sizes are sold out.</p>
      <% end %>
    </div>
  </div>
</section>
