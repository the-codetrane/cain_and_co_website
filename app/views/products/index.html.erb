<% content_for :title, "Merch · Cain & Co." %>
<% content_for :description, "Official Cain & Co. merchandise. Vinyl, shirts, and more — shipped worldwide." %>

<section class="container mx-auto px-5 py-16 max-w-5xl">
  <h1 class="text-4xl font-black tracking-tight">Merch</h1>

  <% if @products.any? %>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @products.each do |product| %>
        <%= link_to product_path(product), class: "group block rounded-2xl border border-neutral-800 bg-neutral-900 overflow-hidden hover:border-neutral-600 transition-colors" do %>
          <% if product.images.attached? %>
            <div class="aspect-square bg-neutral-800 overflow-hidden">
              <%= image_tag product.images.first.variant(resize_to_fill: [400, 400]),
                    class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300",
                    alt: product.name %>
            </div>
          <% else %>
            <div class="aspect-square bg-neutral-800 flex items-center justify-center">
              <span class="text-5xl text-neutral-600">🎸</span>
            </div>
          <% end %>
          <div class="p-5">
            <h2 class="font-bold text-lg"><%= product.name %></h2>
            <% if product.description.present? %>
              <p class="mt-1 text-sm text-neutral-400 line-clamp-2"><%= product.description %></p>
            <% end %>
            <div class="mt-3 flex items-center justify-between">
              <% if product.lowest_price_cents %>
                <span class="text-sm font-semibold">
                  from $<%= "%.2f" % (product.lowest_price_cents / 100.0) %>
                </span>
              <% end %>
              <% unless product.in_stock? %>
                <span class="text-xs text-red-400">Out of stock</span>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="mt-16 text-center">
      <p class="text-lg text-neutral-400">No products available yet. Check back soon.</p>
    </div>
  <% end %>
</section>
