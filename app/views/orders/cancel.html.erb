<% content_for :title, "Checkout Canceled · Cain & Co." %>

<section class="container mx-auto px-5 py-24 max-w-2xl text-center">
  <div class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-neutral-800 mb-6">
    <svg class="h-8 w-8 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </div>

  <h1 class="text-4xl font-black tracking-tight">Checkout canceled.</h1>
  <p class="mt-4 text-lg text-neutral-300">
    No charge was made. Your cart is still waiting.
  </p>

  <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
    <%= link_to "Return to cart", cart_path,
          class: "rounded-xl bg-white px-6 py-3 font-bold text-black hover:bg-neutral-100 transition" %>
    <%= link_to "Continue shopping", products_path,
          class: "text-sm text-neutral-400 hover:text-white" %>
  </div>
</section>
