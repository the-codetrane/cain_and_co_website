<% content_for :title, "Shows · Cain & Co." %>
<% content_for :description, "Catch Cain & Co. live. Browse upcoming tour dates and get tickets." %>

<section class="container mx-auto px-5 py-16 max-w-3xl">
  <div class="flex items-end justify-between mb-10">
    <h1 class="text-4xl font-black tracking-tight">Upcoming shows</h1>
    <%= link_to "Past shows", past_shows_path, class: "text-sm text-neutral-400 hover:text-white" %>
  </div>

  <% if @shows.any? %>
    <div class="flex flex-col gap-5">
      <%= render @shows %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-10 text-center">
      <p class="text-lg text-neutral-300">No shows on the books right now.</p>
      <p class="mt-2 text-neutral-500">Check back soon — or join the newsletter to hear first.</p>
    </div>
  <% end %>
</section>
