<div style="font-family:sans-serif;max-width:600px;margin:0 auto;color:#111;">
  <div style="background:#000;padding:24px 32px;text-align:center;">
    <h1 style="color:#fff;font-size:24px;font-weight:900;letter-spacing:-0.5px;margin:0;">
      Cain &amp; Co.
    </h1>
  </div>

  <div style="padding:32px;">
    <h2 style="font-size:20px;font-weight:700;margin:0 0 8px;">Order confirmed!</h2>
    <p style="color:#555;margin:0 0 24px;">
      Thanks<%= " #{@order.buyer_name}," if @order.buyer_name.present? %> your merch is on its way.
    </p>

    <table style="width:100%;border-collapse:collapse;margin-bottom:24px;">
      <thead>
        <tr style="border-bottom:2px solid #eee;">
          <th style="text-align:left;padding:8px 0;font-size:13px;color:#777;">Item</th>
          <th style="text-align:center;padding:8px 0;font-size:13px;color:#777;">Qty</th>
          <th style="text-align:right;padding:8px 0;font-size:13px;color:#777;">Price</th>
        </tr>
      </thead>
      <tbody>
        <% @order.order_items.each do |item| %>
          <tr style="border-bottom:1px solid #f0f0f0;">
            <td style="padding:10px 0;font-size:14px;"><%= item.variant_name %></td>
            <td style="padding:10px 0;font-size:14px;text-align:center;"><%= item.quantity %></td>
            <td style="padding:10px 0;font-size:14px;text-align:right;">
              $<%= "%.2f" % (item.subtotal_cents / 100.0) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <table style="width:100%;border-collapse:collapse;margin-bottom:24px;">
      <tr>
        <td style="padding:4px 0;font-size:14px;color:#555;">Subtotal</td>
        <td style="padding:4px 0;font-size:14px;text-align:right;">$<%= "%.2f" % (@order.subtotal_cents / 100.0) %></td>
      </tr>
      <tr>
        <td style="padding:4px 0;font-size:14px;color:#555;">Shipping</td>
        <td style="padding:4px 0;font-size:14px;text-align:right;">$<%= "%.2f" % (@order.shipping_cents / 100.0) %></td>
      </tr>
      <tr style="border-top:2px solid #eee;">
        <td style="padding:8px 0 0;font-size:16px;font-weight:700;">Total</td>
        <td style="padding:8px 0 0;font-size:16px;font-weight:700;text-align:right;">$<%= "%.2f" % (@order.total_cents / 100.0) %></td>
      </tr>
    </table>

    <% if @order.shipping_address.present? %>
      <div style="background:#f8f8f8;border-radius:8px;padding:16px;margin-bottom:24px;">
        <p style="font-size:13px;font-weight:700;margin:0 0 4px;color:#555;">Shipping to</p>
        <p style="font-size:14px;margin:0;white-space:pre-line;"><%= @order.shipping_address.gsub(", ", "\n") %></p>
      </div>
    <% end %>

    <p style="font-size:13px;color:#777;margin:0;">
      Questions? Reply to this email — we're happy to help.
    </p>
  </div>

  <div style="background:#f8f8f8;padding:16px 32px;text-align:center;">
    <p style="font-size:12px;color:#999;margin:0;">
      Cain &amp; Co. · Order #<%= @order.id %>
    </p>
  </div>
</div>
