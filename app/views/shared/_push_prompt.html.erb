<% vapid_key = Rails.application.credentials.dig(:vapid, :public_key) %>
<% if vapid_key %>
  <div data-controller="push-notifications"
       data-push-notifications-vapid-public-key-value="<%= vapid_key %>">
    <div data-push-notifications-target="prompt" hidden
         class="fixed bottom-5 left-4 right-4 z-50 mx-auto max-w-sm rounded-2xl border border-neutral-700 bg-neutral-900 p-4 shadow-2xl">
      <p class="text-sm font-semibold">Stay in the loop</p>
      <p class="mt-1 text-xs text-neutral-400">Get notified when new shows are announced or merch drops.</p>
      <div class="mt-3 flex items-center gap-3">
        <button data-action="click->push-notifications#subscribe"
                class="rounded-lg bg-white px-3 py-1.5 text-xs font-bold text-black hover:bg-neutral-100 transition">
          Enable notifications
        </button>
        <button data-action="click->push-notifications#dismiss"
                class="text-xs text-neutral-500 hover:text-neutral-300 transition">
          Not now
        </button>
      </div>
    </div>

    <div data-push-notifications-target="iosHint" hidden
         class="fixed bottom-5 left-4 right-4 z-50 mx-auto max-w-sm rounded-2xl border border-neutral-700 bg-neutral-900 p-4 shadow-2xl">
      <p class="text-sm font-semibold">Enable notifications on iPhone</p>
      <p class="mt-1 text-xs text-neutral-400">
        Tap <strong>Share</strong> &rsaquo; <strong>Add to Home Screen</strong>, then open the app to subscribe.
      </p>
      <button data-action="click->push-notifications#dismiss"
              class="mt-3 text-xs text-neutral-500 hover:text-neutral-300 transition">
        Dismiss
      </button>
    </div>
  </div>
<% end %>
