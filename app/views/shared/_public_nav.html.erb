<%# Mobile-first sticky nav. Hamburger toggles the drawer via the mobile_menu Stimulus controller. %>
<header class="sticky top-0 z-40 border-b border-neutral-800 bg-neutral-950/90 backdrop-blur"
        data-controller="mobile-menu">
  <nav class="container mx-auto flex items-center justify-between px-5 py-4">
    <%= link_to root_path, class: "text-lg font-black tracking-[0.2em] uppercase" do %>
      Cain&nbsp;&amp;&nbsp;Co.
    <% end %>

    <%# Desktop links %>
    <div class="hidden md:flex items-center gap-8 text-sm font-medium uppercase tracking-wide">
      <%= link_to "Home", root_path, class: "hover:text-white text-neutral-300" %>
      <%= link_to "Shows", shows_path, class: "hover:text-white text-neutral-300" %>
      <%= link_to "About", about_path, class: "hover:text-white text-neutral-300" %>
      <a href="<%= root_path %>#newsletter" class="hover:text-white text-neutral-300">Newsletter</a>
      <%= link_to "Merch", products_path, class: "hover:text-white text-neutral-300" %>
    </div>

    <div class="hidden md:flex items-center gap-2">
      <%= link_to(authenticated? ? admin_root_path : new_session_path,
            class: "text-xs font-medium uppercase tracking-wide text-neutral-500 hover:text-neutral-300 transition px-1") do %>
        Admin
      <% end %>
      <%= link_to cart_path, class: "text-neutral-300 hover:text-white p-1", aria: { label: "Cart" } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13l-1.35 2.7A1 1 0 007 17h10M7 13L5.4 5M17 17a2 2 0 11-4 0 2 2 0 014 0zm-8 0a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      <% end %>
    </div>

    <%# Mobile hamburger %>
    <button type="button" class="md:hidden p-2 -mr-2 text-neutral-200"
            data-action="mobile-menu#toggle"
            data-mobile-menu-target="button"
            aria-label="Toggle menu"
            aria-expanded="false"
            aria-controls="mobile-nav-menu">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <%# Mobile drawer %>
  <div id="mobile-nav-menu" data-mobile-menu-target="menu" class="hidden md:hidden border-t border-neutral-800 px-5 py-4">
    <div class="flex flex-col gap-4 text-sm font-medium uppercase tracking-wide" data-action="click->mobile-menu#close">
      <%= link_to "Home", root_path, class: "text-neutral-200" %>
      <%= link_to "Shows", shows_path, class: "text-neutral-200" %>
      <%= link_to "About", about_path, class: "text-neutral-200" %>
      <a href="<%= root_path %>#newsletter" class="text-neutral-200">Newsletter</a>
      <%= link_to "Merch", products_path, class: "text-neutral-200" %>
      <%= link_to "Cart", cart_path, class: "text-neutral-200" %>
      <div class="border-t border-neutral-800 pt-4 mt-1">
        <%= link_to(authenticated? ? admin_root_path : new_session_path,
              class: "text-neutral-500 hover:text-neutral-300 transition") do %>
          Admin
        <% end %>
      </div>
    </div>
  </div>
</header>
