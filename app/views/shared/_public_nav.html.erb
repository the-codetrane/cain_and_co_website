<%# Mobile-first sticky nav. Hamburger toggles the drawer via the mobile_menu Stimulus controller. %>
<header class="sticky top-0 z-40 border-b border-neutral-800 bg-neutral-950/90 backdrop-blur"
        data-controller="mobile-menu">
  <nav class="container mx-auto flex items-center justify-between px-5 py-4">
    <%= link_to root_path, class: "text-lg font-black tracking-[0.2em] uppercase" do %>
      Cain&nbsp;&amp;&nbsp;Co.
    <% end %>

    <%# Desktop links %>
    <div class="hidden md:flex items-center gap-8 text-sm font-medium uppercase tracking-wide">
      <%= link_to "Home", root_path, class: "hover:text-white text-neutral-300" %>
      <%= link_to "Shows", shows_path, class: "hover:text-white text-neutral-300" %>
      <%= link_to "About", about_path, class: "hover:text-white text-neutral-300" %>
      <a href="<%= root_path %>#newsletter" class="hover:text-white text-neutral-300">Newsletter</a>
      <a href="<%= root_path %>#merch" class="hover:text-white text-neutral-300">Merch</a>
    </div>

    <%# Mobile hamburger %>
    <button type="button" class="md:hidden p-2 -mr-2 text-neutral-200"
            data-action="mobile-menu#toggle" aria-label="Toggle menu">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <%# Mobile drawer %>
  <div data-mobile-menu-target="menu" class="hidden md:hidden border-t border-neutral-800 px-5 py-4">
    <div class="flex flex-col gap-4 text-sm font-medium uppercase tracking-wide" data-action="click->mobile-menu#close">
      <%= link_to "Home", root_path, class: "text-neutral-200" %>
      <%= link_to "Shows", shows_path, class: "text-neutral-200" %>
      <%= link_to "About", about_path, class: "text-neutral-200" %>
      <a href="<%= root_path %>#newsletter" class="text-neutral-200">Newsletter</a>
      <a href="<%= root_path %>#merch" class="text-neutral-200">Merch</a>
    </div>
  </div>
</header>
