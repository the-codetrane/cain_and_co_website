<% content_for :title, "Accept invitation · Cain & Co." %>

<div class="min-h-screen flex items-center justify-center px-5">
  <div class="w-full max-w-sm">
    <div class="mb-8 text-center">
      <%= link_to root_path, class: "text-xl font-black tracking-[0.2em] uppercase hover:opacity-80 transition" do %>
        Cain&nbsp;&amp;&nbsp;Co.
      <% end %>
      <p class="mt-2 text-sm text-neutral-400">Create your account</p>
    </div>

    <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-8">
      <%= form_with url: invitation_path(params[:token]), method: :patch do |f| %>
        <div class="space-y-4">
          <div>
            <%= f.label :email_address, "Email", class: "block text-sm font-medium text-neutral-300 mb-1.5" %>
            <%= f.email_field :email_address,
                  value: @invitation.email,
                  readonly: true,
                  autocomplete: "username",
                  class: "w-full rounded-lg border border-neutral-800 bg-neutral-900 px-4 py-2.5 text-sm text-neutral-400 focus:outline-none" %>
          </div>

          <div>
            <%= f.label :password, "Password (at least #{User::PASSWORD_MIN_LENGTH} characters)", class: "block text-sm font-medium text-neutral-300 mb-1.5" %>
            <%= f.password_field :password,
                  required: true,
                  autofocus: true,
                  autocomplete: "new-password",
                  minlength: User::PASSWORD_MIN_LENGTH,
                  maxlength: 72,
                  class: "w-full rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2.5 text-sm text-neutral-100 placeholder-neutral-500 focus:border-white focus:outline-none transition" %>
          </div>

          <div>
            <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-neutral-300 mb-1.5" %>
            <%= f.password_field :password_confirmation,
                  required: true,
                  autocomplete: "new-password",
                  minlength: User::PASSWORD_MIN_LENGTH,
                  maxlength: 72,
                  class: "w-full rounded-lg border border-neutral-700 bg-neutral-950 px-4 py-2.5 text-sm text-neutral-100 placeholder-neutral-500 focus:border-white focus:outline-none transition" %>
          </div>
        </div>

        <%= f.submit "Create account",
              class: "mt-6 w-full rounded-lg bg-white px-4 py-2.5 text-sm font-bold text-neutral-900 hover:bg-neutral-100 transition cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>
