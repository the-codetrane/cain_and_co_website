#!/usr/bin/env ruby
# Verify that the credentials key available to this process actually decrypts the
# environment's encrypted credentials.
#
# Production reads config/credentials/production.yml.enc. Rails resolves the key as
# read_env_key || read_key_file, so RAILS_MASTER_KEY -- when set -- wins over
# config/credentials/production.key. Pointing it at the wrong key (config/master.key,
# say, which belongs to config/credentials.yml.enc) is not caught until the container
# boots, where it surfaces as an opaque "AEAD authentication tag verification failed"
# and a deploy that times out waiting for a health check that never comes.
#
# Run this before deploying to turn that into an immediate, legible failure.
#
#   bin/verify_credentials_key [environment]   # default: production

require "rubygems"
require "bundler/setup"
require "active_support"
require "active_support/encrypted_file"

env = ARGV[0] || "production"
content_path = "config/credentials/#{env}.yml.enc"
key_path = "config/credentials/#{env}.key"

unless File.exist?(content_path)
  abort "#{content_path} does not exist -- nothing to verify for the #{env} environment."
end

source =
  if ENV["RAILS_MASTER_KEY"].to_s.strip.empty?
    File.exist?(key_path) ? key_path : nil
  else
    "the RAILS_MASTER_KEY environment variable"
  end

if source.nil?
  abort "No key available: RAILS_MASTER_KEY is unset and #{key_path} is missing."
end

begin
  ActiveSupport::EncryptedFile.new(
    content_path: content_path,
    key_path: key_path,
    env_key: "RAILS_MASTER_KEY",
    raise_if_missing_key: true
  ).read
rescue ActiveSupport::MessageEncryptor::InvalidMessage
  abort <<~MSG
    The key from #{source} does not decrypt #{content_path}.

    This is the wrong key, not a corrupt file. #{env.capitalize} uses environment-scoped
    credentials, so the key must be the contents of #{key_path} -- not config/master.key,
    which only opens config/credentials.yml.enc.
  MSG
rescue => e
  abort "Could not read #{content_path} using #{source}: #{e.class}: #{e.message}"
end

puts "OK: the key from #{source} decrypts #{content_path}."
